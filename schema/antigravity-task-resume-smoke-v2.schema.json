{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/antigravity-task-resume-smoke-v2.schema.json",
  "title": "Threadforge installed Antigravity task-resume receipt smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "host_cli_version", "provider", "tool", "tool_call_count",
    "tool_result_observed", "task_context_content_retained_in_report", "advisory_result_markers_verified",
    "requirements_not_finalized_warning_verified", "action_ready", "guidance_only", "execution_authorized",
    "receipt_v4_contract_verified", "receipt_task_revision_binding_verified", "receipt_persisted_locally",
    "receipt_list_content_free", "provider_requests", "auxiliary_provider_requests",
    "local_fixture_authentication_validated", "external_network_attempts_blocked", "real_model_invocations"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.antigravity-task-resume-smoke.v2" },
    "status": { "const": "verified" },
    "host_cli_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provider": { "const": "loopback-gemini-api-fixture" },
    "tool": { "const": "threadforge_task_resume_context_with_receipt" },
    "tool_call_count": { "const": 1 },
    "tool_result_observed": { "const": true },
    "task_context_content_retained_in_report": { "const": false },
    "advisory_result_markers_verified": { "const": true },
    "requirements_not_finalized_warning_verified": { "const": true },
    "action_ready": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false },
    "receipt_v4_contract_verified": { "const": true },
    "receipt_task_revision_binding_verified": { "const": true },
    "receipt_persisted_locally": { "const": true },
    "receipt_list_content_free": { "const": true },
    "provider_requests": { "type": "integer", "minimum": 1, "maximum": 20 },
    "auxiliary_provider_requests": { "type": "integer", "minimum": 0, "maximum": 8 },
    "local_fixture_authentication_validated": { "const": true },
    "external_network_attempts_blocked": { "type": "integer", "minimum": 0, "maximum": 100 },
    "real_model_invocations": { "const": 0 }
  }
}
