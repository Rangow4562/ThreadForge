{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-export-cases-request-v1.schema.json",
  "title": "Threadforge local AnyJev typed-case export request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_path", "output_root", "split", "workflows"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-export-cases-request.v1"},
    "dataset_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "output_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "split": {"enum": ["train", "test"]},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["security_incidents", "invoice_processing", "customer_service", "agent_trace_observability"]}
    },
    "max_cases_per_workflow": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 5000}
  }
}
