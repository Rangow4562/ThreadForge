{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-extract-result-v1.schema.json",
  "title": "Threadforge AnyJev local student-feature extraction result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "student_sha256", "student_checkpoint_sha256", "question_count", "total_synthetic_examples", "caches", "human_review_required", "model_inference_verified", "execution_verified", "cutover_evidence_eligible"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-extract-result.v1"},
    "student_sha256": {"$ref": "#/$defs/sha256"},
    "student_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "question_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "total_synthetic_examples": {"type": "integer", "minimum": 1, "maximum": 100000},
    "caches": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/cache"}},
    "human_review_required": {"const": true},
    "model_inference_verified": {"const": true},
    "execution_verified": {"const": false},
    "cutover_evidence_eligible": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "question_sha256", "student_sha256", "student_checkpoint_sha256", "source_sha256", "examples", "classes", "block", "feature_width", "relative_path", "sha256"],
      "properties": {
        "role": {"const": "student_synthetic_features"},
        "question_sha256": {"$ref": "#/$defs/sha256"},
        "student_sha256": {"$ref": "#/$defs/sha256"},
        "student_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "examples": {"type": "integer", "minimum": 1, "maximum": 10000},
        "classes": {"type": "integer", "minimum": 2, "maximum": 26},
        "block": {"type": "integer", "minimum": 1, "maximum": 100000},
        "feature_width": {"type": "integer", "minimum": 1, "maximum": 65536},
        "relative_path": {"type": "string", "pattern": "^distillation/synth_features/[a-f0-9]{64}/[a-f0-9]{64}\\.synth\\.npz$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
