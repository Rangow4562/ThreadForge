{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-pipeline-request-v1.schema.json",
  "title": "Threadforge local AnyJev end-to-end distillation pipeline request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_path", "staging_root", "cache_root", "workflows", "generator", "teacher", "students"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-pipeline-request.v1"},
    "dataset_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "staging_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "cache_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "workflows": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["security_incidents", "invoice_processing", "customer_service", "agent_trace_observability"]}
    },
    "calibration_examples": {"type": "integer", "minimum": 8, "maximum": 5000, "default": 300},
    "budgets": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 5000}, "default": [300, 1200]},
    "bootstrap_resamples": {"type": "integer", "minimum": 100, "maximum": 10000, "default": 1000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 0},
    "generator": {"$ref": "#/$defs/generator"},
    "teacher": {"$ref": "#/$defs/teacher"},
    "students": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/student"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "model_path"],
      "properties": {
        "type": {"const": "hf"},
        "model_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "device": {"type": "string", "pattern": "^(cpu|mps|cuda(:[0-9]+)?)$", "default": "cpu"},
        "dtype": {"enum": ["auto", "float32", "float16", "bfloat16"], "default": "float32"},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
      }
    },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "checkpoint_sha256", "backend"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "backend": {"$ref": "#/$defs/backend"},
        "per_workflow": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 1200},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 64, "default": 16},
        "max_new_tokens": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 700},
        "temperature": {"type": "number", "minimum": 0.01, "maximum": 2.0, "default": 1.0},
        "top_p": {"type": "number", "minimum": 0.01, "maximum": 1.0, "default": 0.95},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "teacher": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "checkpoint_sha256", "backend", "artifact", "block", "n_layers"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "backend": {"$ref": "#/$defs/backend"},
        "artifact": {"type": "object"},
        "block": {"type": "integer", "minimum": 1, "maximum": 100000},
        "n_layers": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "student": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "checkpoint_sha256", "backend", "block", "n_layers"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "backend": {"$ref": "#/$defs/backend"},
        "block": {"type": "integer", "minimum": 1, "maximum": 100000},
        "n_layers": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    }
  }
}
