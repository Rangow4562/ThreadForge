{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-result-v1.schema.json",
  "title": "Threadforge AnyJev distillation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "teacher_sha256",
    "budgets",
    "question_count",
    "test_examples",
    "teacher_metrics",
    "students",
    "questions",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.anyjev-distillation-result.v1"
    },
    "source_kind": {
      "enum": ["head_fit", "head_soft"]
    },
    "teacher_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "teacher_block": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "budgets": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "question_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "test_examples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "teacher_metrics": {
      "$ref": "#/$defs/pooledMetrics"
    },
    "students": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/student"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "omitted_fields": {
      "const": [
        "teacher_label",
        "student_labels",
        "question_labels",
        "method_labels",
        "date",
        "environment_details",
        "synthetic_states",
        "per-example_predictions"
      ]
    },
    "human_review_required": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "cutover_evidence_eligible": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"source_kind": {"const": "head_soft"}},
        "required": ["source_kind"]
      },
      "then": {
        "required": ["teacher_block"],
        "properties": {"budgets": {"maxItems": 0}}
      },
      "else": {
        "not": {"required": ["teacher_block"]},
        "properties": {"budgets": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "accuracyInterval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "differenceInterval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": -1, "maximum": 1}
    },
    "pooledMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "ece", "nll", "examples", "accuracy_ci95"],
      "properties": {
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "ece": {"type": "number", "minimum": 0, "maximum": 1},
        "nll": {"type": "number", "minimum": 0, "maximum": 1000000},
        "examples": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "accuracy_ci95": {"$ref": "#/$defs/accuracyInterval"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_sha256",
        "accuracy",
        "ece",
        "nll",
        "examples",
        "accuracy_ci95",
        "difference_vs_baseline_ci95"
      ],
      "properties": {
        "method_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "ece": {"type": "number", "minimum": 0, "maximum": 1},
        "nll": {"type": "number", "minimum": 0, "maximum": 1000000},
        "examples": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "accuracy_ci95": {"$ref": "#/$defs/accuracyInterval"},
        "difference_vs_baseline_ci95": {"$ref": "#/$defs/differenceInterval"}
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_sha256", "block", "teacher_vs_baseline_ci95", "methods"],
      "properties": {
        "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "block": {"type": "integer", "minimum": 1, "maximum": 100000},
        "teacher_vs_baseline_ci95": {"$ref": "#/$defs/differenceInterval"},
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65,
          "items": {"$ref": "#/$defs/method"}
        }
      }
    },
    "questionMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_sha256", "accuracy"],
      "properties": {
        "method_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "questionStudent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_sha256", "methods"],
      "properties": {
        "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65,
          "items": {"$ref": "#/$defs/questionMethod"}
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_sha256", "teacher_accuracy", "students"],
      "properties": {
        "question_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "teacher_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "teacher_oof_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "students": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/questionStudent"}
        }
      }
    }
  }
}
