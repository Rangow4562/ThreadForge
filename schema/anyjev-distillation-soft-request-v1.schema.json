{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-soft-request-v1.schema.json",
  "title": "Threadforge AnyJev same-state soft-target distillation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cache_root", "teacher_model", "teacher_block", "teacher_n_layers", "questions"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-soft-request.v1"},
    "cache_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "teacher_model": {"type": "string", "minLength": 1, "maxLength": 512},
    "teacher_block": {"type": "integer", "minimum": 1, "maximum": 100000},
    "teacher_n_layers": {"type": "integer", "minimum": 1, "maximum": 100000},
    "bootstrap_resamples": {"type": "integer", "minimum": 100, "maximum": 10000, "default": 1000},
    "questions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "relativeNpz": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\:]).+\\.npz$"},
    "student": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "block", "n_layers", "gold_train_path", "gold_test_path"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "block": {"type": "integer", "minimum": 1, "maximum": 100000},
        "n_layers": {"type": "integer", "minimum": 1, "maximum": 100000},
        "gold_train_path": {"$ref": "#/$defs/relativeNpz"},
        "gold_test_path": {"$ref": "#/$defs/relativeNpz"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "teacher_train_path", "teacher_test_path", "students"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "teacher_train_path": {"$ref": "#/$defs/relativeNpz"},
        "teacher_test_path": {"$ref": "#/$defs/relativeNpz"},
        "students": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/student"}}
      }
    }
  }
}
