{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-soft-result-v1.schema.json",
  "title": "Threadforge AnyJev same-state soft-target distillation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "teacher_sha256", "teacher_block", "question_count", "total_test_examples",
    "bootstrap_resamples", "teacher", "students", "per_question", "input_digests",
    "human_review_required", "model_inference_verified", "execution_verified", "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-soft-result.v1"},
    "teacher_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_block": {"type": "integer", "minimum": 1, "maximum": 100000},
    "question_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "total_test_examples": {"type": "integer", "minimum": 2, "maximum": 100000},
    "bootstrap_resamples": {"type": "integer", "minimum": 100, "maximum": 10000},
    "teacher": {"$ref": "#/$defs/summary"},
    "students": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/studentResult"}},
    "per_question": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/questionResult"}},
    "input_digests": {"type": "array", "minItems": 4, "maxItems": 20000, "items": {"$ref": "#/$defs/inputDigest"}},
    "human_review_required": {"const": true},
    "model_inference_verified": {"const": false},
    "execution_verified": {"const": false},
    "cutover_evidence_eligible": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "interval": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2},
    "differenceInterval": {"type": "array", "prefixItems": [{"type": "number", "minimum": -1, "maximum": 1}, {"type": "number", "minimum": -1, "maximum": 1}], "minItems": 2, "maxItems": 2},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["accuracy", "expected_calibration_error", "negative_log_loss", "examples", "accuracy_ci95"],
      "properties": {
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_calibration_error": {"type": "number", "minimum": 0, "maximum": 1},
        "negative_log_loss": {"type": "number", "minimum": 0, "maximum": 35},
        "examples": {"type": "integer", "minimum": 2, "maximum": 100000},
        "accuracy_ci95": {"$ref": "#/$defs/interval"}
      },
      "patternProperties": {"^diff_vs_gold_ci95$": {"$ref": "#/$defs/differenceInterval"}}
    },
    "methodMetrics": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/summary"},
      "propertyNames": {"enum": ["teacher", "gold", "teacher-argmax", "teacher-soft", "gold+teacher-soft"]}
    },
    "studentResult": {
      "type": "object", "additionalProperties": false, "required": ["student_sha256", "block", "methods"],
      "properties": {"student_sha256": {"$ref": "#/$defs/sha256"}, "block": {"type": "integer", "minimum": 1, "maximum": 100000}, "methods": {"$ref": "#/$defs/methodMetrics"}}
    },
    "perQuestionMethod": {
      "type": "object", "additionalProperties": false, "required": ["accuracy", "examples"],
      "properties": {"accuracy": {"type": "number", "minimum": 0, "maximum": 1}, "examples": {"type": "integer", "minimum": 2, "maximum": 100000}}
    },
    "questionStudent": {
      "type": "object", "additionalProperties": false, "required": ["model_sha256", "block", "methods"],
      "properties": {"model_sha256": {"$ref": "#/$defs/sha256"}, "block": {"type": "integer", "minimum": 1, "maximum": 100000}, "methods": {"type": "object", "additionalProperties": {"$ref": "#/$defs/perQuestionMethod"}, "propertyNames": {"enum": ["teacher", "gold", "teacher-argmax", "teacher-soft", "gold+teacher-soft"]}}}
    },
    "questionResult": {
      "type": "object", "additionalProperties": false,
      "required": ["question_sha256", "examples", "teacher_accuracy", "teacher_oof_agreement_with_gold", "students"],
      "properties": {
        "question_sha256": {"$ref": "#/$defs/sha256"},
        "examples": {"type": "integer", "minimum": 2, "maximum": 100000},
        "teacher_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "teacher_oof_agreement_with_gold": {"type": "number", "minimum": 0, "maximum": 1},
        "students": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/questionStudent"}}
      }
    },
    "inputDigest": {
      "type": "object", "additionalProperties": false, "required": ["role", "question_sha256", "sha256"],
      "properties": {
        "role": {"enum": ["teacher_train_features", "teacher_test_features", "student_gold_train_features", "student_gold_test_features"]},
        "question_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
