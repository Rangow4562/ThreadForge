{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-synth-request-v1.schema.json",
  "title": "Threadforge AnyJev local synthetic-state generation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_root", "cache_root", "generator_model", "generator_checkpoint_sha256", "backend", "workflows"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-synth-request.v1"},
    "source_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "cache_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "generator_model": {"type": "string", "minLength": 1, "maxLength": 512},
    "generator_checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "backend": {"$ref": "#/$defs/backend"},
    "per_workflow": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 1200},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 64, "default": 16},
    "max_new_tokens": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 700},
    "temperature": {"type": "number", "minimum": 0.01, "maximum": 2.0, "default": 1.0},
    "top_p": {"type": "number", "minimum": 0.01, "maximum": 1.0, "default": 0.95},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100000},
    "workflows": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/workflow"}}
  },
  "$defs": {
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "model_path"],
      "properties": {
        "type": {"const": "hf"},
        "model_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "device": {"type": "string", "pattern": "^(cpu|mps|cuda(:[0-9]+)?)$", "default": "cpu"},
        "dtype": {"enum": ["auto", "float32", "float16", "bfloat16"], "default": "float32"},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "exemplars_path"],
      "properties": {
        "workflow": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "exemplars_path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\:]).+\\.json$"}
      }
    }
  }
}
