{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-synth-result-v1.schema.json",
  "title": "Threadforge AnyJev local synthetic-state generation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_sha256", "generator_checkpoint_sha256", "workflow_count", "total_synthetic_examples", "total_generated", "total_rejected", "outputs", "human_review_required", "model_inference_verified", "execution_verified", "cutover_evidence_eligible"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-synth-result.v1"},
    "generator_sha256": {"$ref": "#/$defs/sha256"},
    "generator_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "workflow_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "total_synthetic_examples": {"type": "integer", "minimum": 1, "maximum": 100000},
    "total_generated": {"type": "integer", "minimum": 1, "maximum": 100000},
    "total_rejected": {"type": "integer", "minimum": 0, "maximum": 100000},
    "outputs": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/output"}},
    "human_review_required": {"const": true},
    "model_inference_verified": {"const": true},
    "execution_verified": {"const": false},
    "cutover_evidence_eligible": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_sha256", "source_sha256", "examples", "generated", "rejected", "relative_path", "sha256"],
      "properties": {
        "workflow_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "examples": {"type": "integer", "minimum": 1, "maximum": 5000},
        "generated": {"type": "integer", "minimum": 1, "maximum": 100000},
        "rejected": {"type": "integer", "minimum": 0, "maximum": 100000},
        "relative_path": {"type": "string", "pattern": "^distillation/synth/[a-f0-9]{64}/[a-f0-9]{64}\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
