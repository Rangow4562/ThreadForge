{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-distillation-synthetic-states-v1.schema.json",
  "title": "Threadforge AnyJev generated synthetic states v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "generator", "n", "generated", "rejected", "reject_reasons", "settings", "states"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-distillation-synthetic-states.v1"},
    "workflow": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "generator": {"type": "string", "minLength": 1, "maxLength": 512},
    "n": {"type": "integer", "minimum": 1, "maximum": 5000},
    "generated": {"type": "integer", "minimum": 1, "maximum": 100000},
    "rejected": {"type": "integer", "minimum": 0, "maximum": 100000},
    "reject_reasons": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100000}},
    "settings": {"type": "object", "additionalProperties": false, "required": ["temperature", "top_p", "seed", "max_new_tokens", "exemplars_per_prompt", "batch_size", "max_attempts"], "properties": {
      "temperature": {"type": "number", "minimum": 0.01, "maximum": 2.0},
      "top_p": {"type": "number", "minimum": 0.01, "maximum": 1.0},
      "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
      "max_new_tokens": {"type": "integer", "minimum": 1, "maximum": 1024},
      "exemplars_per_prompt": {"const": 3},
      "batch_size": {"type": "integer", "minimum": 1, "maximum": 64},
      "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100000}
    }},
    "states": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"type": "object"}}
  }
}
