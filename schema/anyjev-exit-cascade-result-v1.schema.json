{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-exit-cascade-result-v1.schema.json",
  "title": "Threadforge AnyJev exit cascade result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_sha256",
    "transformer_layers",
    "exits",
    "rows",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.anyjev-exit-cascade-result.v1"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transformer_layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "exits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "rows": {
      "type": "array",
      "minItems": 17,
      "maxItems": 1040,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "omitted_fields": {
      "const": ["model_label", "date", "environment_details", "source_row_keys"]
    },
    "human_review_required": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "cutover_evidence_eligible": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ruleRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "rule", "epsilon", "scope", "accuracy", "ece", "nll",
        "mean_blocks", "relative_depth", "excess_error", "exit_shares"
      ],
      "properties": {
        "kind": { "const": "cascade" },
        "rule": { "enum": ["quantile", "ltt"] },
        "epsilon": { "enum": [0, 0.005, 0.01, 0.02] },
        "scope": { "enum": ["per_question", "pooled"] },
        "accuracy": { "$ref": "#/$defs/rate" },
        "ece": { "$ref": "#/$defs/rate" },
        "nll": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "mean_blocks": { "type": "number", "minimum": 1, "maximum": 10000 },
        "relative_depth": { "$ref": "#/$defs/rate" },
        "excess_error": { "type": "number", "minimum": -1, "maximum": 1 },
        "exit_shares": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["block", "share"],
            "properties": {
              "block": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "share": { "$ref": "#/$defs/rate" }
            }
          }
        }
      }
    },
    "fixedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "block", "accuracy", "ece", "nll", "mean_blocks", "relative_depth"],
      "properties": {
        "kind": { "const": "fixed" },
        "block": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "accuracy": { "$ref": "#/$defs/rate" },
        "ece": { "$ref": "#/$defs/rate" },
        "nll": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "mean_blocks": { "type": "number", "minimum": 1, "maximum": 10000 },
        "relative_depth": { "$ref": "#/$defs/rate" }
      }
    },
    "row": {
      "oneOf": [
        { "$ref": "#/$defs/ruleRow" },
        { "$ref": "#/$defs/fixedRow" }
      ]
    }
  }
}
