{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-exit-depth-result-v1.schema.json",
  "title": "Threadforge AnyJev exit depth result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_sha256",
    "blocks",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.anyjev-exit-depth-result.v1"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "omitted_fields": {
      "const": ["model_label", "date", "environment_details"]
    },
    "human_review_required": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "cutover_evidence_eligible": {
      "const": false
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "ece", "nll"],
      "properties": {
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ece": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nll": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "lens", "lens_temperature", "head", "head_flip"],
      "properties": {
        "block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "lens": {
          "$ref": "#/$defs/metric"
        },
        "lens_temperature": {
          "$ref": "#/$defs/metric"
        },
        "head": {
          "$ref": "#/$defs/metric"
        },
        "head_flip": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
