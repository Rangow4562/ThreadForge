{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-exit-jevmode-result-v1.schema.json",
  "title": "Threadforge AnyJev exit Jev-mode result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_sha256",
    "transformer_layers",
    "blocks",
    "kinds",
    "slack",
    "recommended_block",
    "oof_accuracy_by_block",
    "per_block",
    "questions",
    "rules",
    "references",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.anyjev-exit-jevmode-result.v1"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transformer_layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["lda", "ridge"]
      }
    },
    "slack": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recommended_block": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "oof_accuracy_by_block": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/rate"
      }
    },
    "per_block": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/blockSummary"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/questionSummary"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/ruleSummary"
      }
    },
    "references": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "omitted_fields": {
      "const": [
        "model_label",
        "date",
        "environment_details",
        "question_labels",
        "reference_paths",
        "embedded_latency_reference"
      ]
    },
    "human_review_required": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "cutover_evidence_eligible": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nll": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "ci": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "blockSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "accuracy",
        "accuracy_ci95",
        "diff_vs_full_ci95",
        "ece",
        "flip",
        "nll",
        "oof_accuracy",
        "relative_depth"
      ],
      "properties": {
        "block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "accuracy": {
          "$ref": "#/$defs/rate"
        },
        "accuracy_ci95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/rate"
          }
        },
        "diff_vs_full_ci95": {
          "$ref": "#/$defs/ci"
        },
        "ece": {
          "$ref": "#/$defs/rate"
        },
        "flip": {
          "$ref": "#/$defs/rate"
        },
        "nll": {
          "$ref": "#/$defs/nll"
        },
        "oof_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "relative_depth": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "questionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_sha256",
        "option_count",
        "cv_block",
        "oof_accuracy_by_block",
        "oof_nll_by_block",
        "head_kind_by_block",
        "test_accuracy_by_block",
        "test_flip_by_block"
      ],
      "properties": {
        "question_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "option_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "cv_block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "oof_accuracy_by_block": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/rate"
          }
        },
        "oof_nll_by_block": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/nll"
          }
        },
        "head_kind_by_block": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "enum": ["lda", "ridge"]
          }
        },
        "test_accuracy_by_block": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/rate"
          }
        },
        "test_flip_by_block": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/rate"
          }
        }
      }
    },
    "ruleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "accuracy",
        "accuracy_ci95",
        "diff_vs_full_ci95",
        "ece",
        "flip",
        "mean_blocks",
        "nll",
        "relative_depth"
      ],
      "properties": {
        "kind": {
          "enum": ["cv", "fixed"]
        },
        "block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "accuracy": {
          "$ref": "#/$defs/rate"
        },
        "accuracy_ci95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/rate"
          }
        },
        "diff_vs_full_ci95": {
          "$ref": "#/$defs/ci"
        },
        "ece": {
          "$ref": "#/$defs/rate"
        },
        "flip": {
          "$ref": "#/$defs/rate"
        },
        "mean_blocks": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "nll": {
          "$ref": "#/$defs/nll"
        },
        "relative_depth": {
          "$ref": "#/$defs/rate"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fixed"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["block"]
          },
          "else": {
            "not": {
              "required": ["block"]
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accuracy", "ece"],
      "properties": {
        "name": {
          "enum": ["raw", "L0", "L1"]
        },
        "accuracy": {
          "$ref": "#/$defs/rate"
        },
        "ece": {
          "$ref": "#/$defs/rate"
        }
      }
    }
  }
}
