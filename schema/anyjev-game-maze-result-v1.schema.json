{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-game-maze-result-v1.schema.json",
  "title": "Threadforge AnyJev native game maze result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_sha256",
    "maze_size",
    "prior",
    "policy",
    "wall_cost",
    "threshold",
    "calibration_examples",
    "question_digests",
    "levels",
    "episodes",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.anyjev-game-maze-result.v1"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "maze_size": {
      "type": "integer",
      "minimum": 5,
      "maximum": 501
    },
    "prior": {
      "enum": ["batch", "content_free", "none"]
    },
    "policy": {
      "enum": ["expected_cost", "threshold"]
    },
    "wall_cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "calibration_examples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "question_digests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/questionDigest"
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["raw", "L0", "L1"]
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "omitted_fields": {
      "const": [
        "model_label",
        "revision_label",
        "environment_details",
        "question_text",
        "calibration_seed",
        "episode_seed",
        "maze_walls",
        "start_goal_coordinates",
        "prediction_details",
        "move_trace"
      ]
    },
    "human_review_required": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "cutover_evidence_eligible": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "questionDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "sha256"],
      "properties": {
        "direction": {
          "enum": ["north", "east", "south", "west"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_sha256", "runs"],
      "properties": {
        "seed_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "status",
        "steps",
        "collisions",
        "cells_seen",
        "elapsed_seconds",
        "edge_accuracy",
        "edge_brier",
        "mean_p_open",
        "open_rate"
      ],
      "properties": {
        "level": {
          "enum": ["raw", "L0", "L1"]
        },
        "status": {
          "enum": ["goal", "horizon", "stuck"]
        },
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "collisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "cells_seen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 251001
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "edge_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "edge_brier": {
          "$ref": "#/$defs/rate"
        },
        "mean_p_open": {
          "$ref": "#/$defs/rate"
        },
        "open_rate": {
          "$ref": "#/$defs/rate"
        },
        "temperatures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["north", "east", "south", "west"],
          "properties": {
            "north": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
            "east": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
            "south": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
            "west": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": { "const": "L1" }
            },
            "required": ["level"]
          },
          "then": {
            "required": ["temperatures"]
          },
          "else": {
            "not": {
              "required": ["temperatures"]
            }
          }
        }
      ]
    }
  }
}
