{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-latency-benchmark-result-v1.schema.json",
  "title": "Threadforge AnyJev latency benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_sha256",
    "backend",
    "rows",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.anyjev-latency-benchmark-result.v1"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backend": {
      "enum": ["hf", "vllm"]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "omitted_fields": {
      "const": [
        "model_label",
        "date",
        "row_backend",
        "shared_fallbacks_counter"
      ]
    },
    "human_review_required": {
      "const": true
    },
    "execution_verified": {
      "const": false
    },
    "cutover_evidence_eligible": {
      "const": false
    }
  },
  "$defs": {
    "positiveMilliseconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_tokens",
        "option_count",
        "batch_states",
        "batch_raw_ms",
        "batch_l0_full_ms",
        "single_raw_ms",
        "single_l0_full_ms"
      ],
      "properties": {
        "state_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "option_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "batch_states": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "batch_raw_ms": {
          "$ref": "#/$defs/positiveMilliseconds"
        },
        "batch_l0_full_ms": {
          "$ref": "#/$defs/positiveMilliseconds"
        },
        "batch_l0_shared_ms": {
          "$ref": "#/$defs/positiveMilliseconds"
        },
        "single_raw_ms": {
          "$ref": "#/$defs/positiveMilliseconds"
        },
        "single_l0_full_ms": {
          "$ref": "#/$defs/positiveMilliseconds"
        },
        "single_l0_shared_ms": {
          "$ref": "#/$defs/positiveMilliseconds"
        }
      },
      "dependentRequired": {
        "batch_l0_shared_ms": ["single_l0_shared_ms"],
        "single_l0_shared_ms": ["batch_l0_shared_ms"]
      }
    }
  }
}
