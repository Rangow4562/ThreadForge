{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schema/anyjev-paraphrase-order-result-v1.schema.json",
  "title": "Threadforge AnyJev paraphrase and listing-order result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_kind",
    "model_sha256",
    "block",
    "variants",
    "adaptation_budgets",
    "rows",
    "questions",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-paraphrase-order-result.v1"},
    "study_kind": {"enum": ["paraphrase", "listing_order"]},
    "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "block": {"type": "integer", "minimum": 1, "maximum": 10000},
    "variants": {
      "type": "array",
      "items": {"enum": ["orig", "w1", "w2", "w3", "o1"]},
      "uniqueItems": true,
      "maxItems": 5
    },
    "adaptation_budgets": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1, "maximum": 1000000},
      "uniqueItems": true,
      "maxItems": 64
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_key", "accuracy", "ece", "nll", "n"],
        "properties": {
          "metric_key": {"type": "string", "minLength": 1, "maxLength": 128},
          "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
          "ece": {"type": "number", "minimum": 0, "maximum": 1},
          "nll": {"type": "number", "minimum": 0, "maximum": 1000000},
          "n": {"type": "integer", "minimum": 1, "maximum": 100000000},
          "accuracy_ci95": {
            "type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1},
            "minItems": 2, "maxItems": 2
          },
          "diff_vs_orig_ci95": {
            "type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1},
            "minItems": 2, "maxItems": 2
          },
          "flip_vs_orig": {"type": "number", "minimum": 0, "maximum": 1},
          "flip_vs_canonical": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_key_sha256", "k", "kind", "accuracies"],
        "properties": {
          "question_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "k": {"type": "integer", "minimum": 2, "maximum": 26},
          "kind": {"enum": ["choice", "noul", "score"]},
          "accuracies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric_key", "accuracy"],
              "properties": {
                "metric_key": {"type": "string", "minLength": 1, "maxLength": 128},
                "accuracy": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "omitted_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "human_review_required": {"const": true},
    "execution_verified": {"const": false},
    "cutover_evidence_eligible": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"study_kind": {"const": "paraphrase"}}},
      "then": {
        "properties": {
          "variants": {"const": ["orig", "w1", "w2", "w3", "o1"]},
          "rows": {"minItems": 36},
          "questions": {"minItems": 1}
        },
        "allOf": [
          {
            "properties": {
              "rows": {
                "items": {"required": ["accuracy_ci95", "diff_vs_orig_ci95", "flip_vs_orig"]}
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "variants": {"maxItems": 0},
          "adaptation_budgets": {"maxItems": 0},
          "questions": {"maxItems": 0},
          "rows": {"minItems": 6, "maxItems": 6}
        },
        "allOf": [
          {
            "properties": {
              "rows": {"items": {"required": ["flip_vs_canonical"]}}
            }
          }
        ]
      }
    }
  ]
}
