{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/anyjev-serving-pipeline-request-v1.schema.json",
  "title": "Threadforge local AnyJev serving pipeline request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_path", "case_root", "questions"],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-serving-pipeline-request.v1"},
    "model_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "case_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/questionFiles"}
    },
    "depths": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 4096}
    },
    "only_full": {"type": "boolean", "default": false},
    "repeats": {"type": "integer", "minimum": 2, "maximum": 10, "default": 3},
    "port": {"type": "integer", "minimum": 0, "maximum": 65535, "default": 8100},
    "gpu_memory_utilization": {"type": "number", "exclusiveMinimum": 0.05, "maximum": 0.95, "default": 0.85},
    "prefix_caching": {"type": "boolean", "default": false},
    "quantization": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,32}$"},
    "multi_question_states": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 64},
    "startup_timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 900, "default": 900}
  },
  "$defs": {
    "relativeJson": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
    },
    "questionFiles": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "train_cases_path", "test_cases_path"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "train_cases_path": {"$ref": "#/$defs/relativeJson"},
        "test_cases_path": {"$ref": "#/$defs/relativeJson"}
      }
    }
  }
}
