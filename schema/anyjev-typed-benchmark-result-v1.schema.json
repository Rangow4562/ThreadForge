{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/anyjev-typed-benchmark-result-v1.schema.json",
  "title": "Sanitized historical AnyJev typed-decision benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_kind", "backend_kind", "model_sha256", "dataset_label_sha256",
    "test_examples", "levels", "omitted_fields", "human_review_required",
    "execution_verified", "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.anyjev-typed-benchmark-result.v1" },
    "source_kind": { "enum": ["runner_result", "provider_export"] },
    "backend_kind": { "enum": ["hf", "provider"] },
    "model_sha256": { "$ref": "#/$defs/sha256" },
    "provider_sha256": { "$ref": "#/$defs/sha256" },
    "dataset_label_sha256": { "$ref": "#/$defs/sha256" },
    "prior": { "enum": ["batch", "content_free", "none"] },
    "prior_strength": { "type": "number", "minimum": 0, "maximum": 1000000 },
    "test_examples": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "calibration_examples": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "question_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "test_limit": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "levels": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "overall", "by_type"],
        "properties": {
          "name": { "enum": ["provider", "raw", "L0", "L1", "L0-bc", "L0-cf", "L0-perm", "L0-perm+bc", "L0-perm+cf"] },
          "overall": { "$ref": "#/$defs/metrics" },
          "by_type": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "metrics"],
              "properties": {
                "kind": { "enum": ["choice", "noul", "score"] },
                "metrics": { "$ref": "#/$defs/metrics" }
              }
            }
          },
          "by_workflow": {
            "type": "array", "minItems": 1, "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["workflow_sha256", "metrics"],
              "properties": {
                "workflow_sha256": { "$ref": "#/$defs/sha256" },
                "metrics": { "$ref": "#/$defs/metrics" }
              }
            }
          },
          "by_question": {
            "type": "array", "minItems": 1, "maxItems": 10000,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["question_key_sha256", "workflow_sha256", "kind", "option_count", "metrics", "majority", "label_entropy"],
              "properties": {
                "question_key_sha256": { "$ref": "#/$defs/sha256" },
                "workflow_sha256": { "$ref": "#/$defs/sha256" },
                "kind": { "enum": ["choice", "noul", "score"] },
                "option_count": { "type": "integer", "minimum": 2, "maximum": 26 },
                "metrics": { "$ref": "#/$defs/metrics" },
                "majority": { "type": "number", "minimum": 0, "maximum": 1 },
                "label_entropy": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "omitted_fields": {
      "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
      "items": {
        "enum": [
          "model_label", "provider_label", "checkpoint_label", "dataset_label",
          "workflow_labels", "question_labels", "environment_details", "timestamps",
          "timing_metrics", "raw_item_distributions"
        ]
      }
    },
    "human_review_required": { "const": true },
    "execution_verified": { "const": false },
    "cutover_evidence_eligible": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["n", "acc"],
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "acc": { "type": "number", "minimum": 0, "maximum": 1 },
        "soft_acc": { "type": "number", "minimum": 0, "maximum": 1 },
        "ece": { "type": "number", "minimum": 0, "maximum": 1 },
        "brier": { "type": "number", "minimum": 0, "maximum": 2 },
        "brier_mean": { "type": "number", "minimum": 0, "maximum": 2 },
        "nll": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "score_mae": { "type": "number", "minimum": 0, "maximum": 1000000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source_kind": { "const": "runner_result" } }, "required": ["source_kind"] },
      "then": {
        "properties": { "backend_kind": { "const": "hf" } },
        "required": ["prior", "question_count"]
      }
    },
    {
      "if": { "properties": { "source_kind": { "const": "provider_export" } }, "required": ["source_kind"] },
      "then": { "properties": { "backend_kind": { "const": "provider" } } }
    }
  ]
}
