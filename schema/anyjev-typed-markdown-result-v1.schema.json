{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schemas/anyjev-typed-markdown-result-v1.schema.json",
  "title": "Threadforge AnyJev Typed Markdown Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_sha256",
    "systems",
    "omitted_fields",
    "human_review_required",
    "execution_verified",
    "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": {"const": "threadforge.anyjev-typed-markdown-result.v1"},
    "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_sha256", "metrics"],
        "properties": {
          "system_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "required": ["acc"],
            "properties": {
              "acc": {"type": "number", "minimum": 0, "maximum": 1},
              "soft_acc": {"type": "number", "minimum": 0, "maximum": 1},
              "ece": {"type": "number", "minimum": 0, "maximum": 1},
              "brier_mean": {"type": "number", "minimum": 0, "maximum": 2},
              "score_mae": {"type": "number", "minimum": 0, "maximum": 1000000}
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_sha256", "acc", "soft_acc", "n"],
        "properties": {
          "workflow_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "acc": {"type": "number", "minimum": 0, "maximum": 1},
          "soft_acc": {"type": "number", "minimum": 0, "maximum": 1},
          "n": {"type": "integer", "minimum": 1, "maximum": 10000000}
        }
      }
    },
    "workflow_scope": {"const": "anyjev_l0"},
    "omitted_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "human_review_required": {"const": true},
    "execution_verified": {"const": false},
    "cutover_evidence_eligible": {"const": false}
  }
}
