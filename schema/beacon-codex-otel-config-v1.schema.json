{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/beacon-codex-otel-config-v1.schema.json",
  "title": "Sanitized Beacon Codex OTEL configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_format",
    "kind",
    "harness",
    "otel_configured",
    "log_exporters",
    "trace_exporters",
    "omitted_fields",
    "human_review_required",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.beacon-codex-otel-config.v1" },
    "source_format": { "const": "toml" },
    "kind": { "const": "codex_otel_configuration" },
    "harness": { "const": "codex_cli" },
    "otel_configured": { "const": true },
    "environment": { "enum": ["dev", "ci"] },
    "log_user_prompt": { "type": "boolean" },
    "log_exporters": { "$ref": "#/$defs/exporters" },
    "trace_exporters": { "$ref": "#/$defs/exporters" },
    "omitted_fields": {
      "const": [
        "credentials",
        "exporter_endpoints",
        "headers",
        "local_paths",
        "unrelated_settings"
      ]
    },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false }
  },
  "anyOf": [
    { "properties": { "log_exporters": { "minItems": 1 } } },
    { "properties": { "trace_exporters": { "minItems": 1 } } }
  ],
  "$defs": {
    "exporters": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "endpoint_scope"],
        "properties": {
          "name": { "enum": ["otlp-grpc", "otlp-http"] },
          "endpoint_scope": {
            "enum": ["not_configured", "loopback", "non_loopback", "unknown"]
          }
        }
      }
    }
  }
}
