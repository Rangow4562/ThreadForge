{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schemas/beacon-hook-log-summary-v1.schema.json",
  "title": "Threadforge Beacon Hook Log Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_format",
    "kind",
    "harness",
    "entry_count",
    "level_counts",
    "first_day",
    "last_day",
    "omitted_fields",
    "human_review_required",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.beacon-hook-log-summary.v1" },
    "source_format": { "const": "jsonl" },
    "kind": { "const": "hook_log_summary" },
    "harness": {
      "enum": [
        "antigravity",
        "claude_code",
        "cline",
        "cursor",
        "deepseek_harness",
        "devin_cli",
        "factory_droid",
        "github_copilot",
        "grok_build",
        "hermes_agent",
        "kiro",
        "kimi_code",
        "muse_code",
        "openhands",
        "opencode",
        "qwen_code",
        "vscode_copilot"
      ]
    },
    "entry_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "level_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debug", "error", "info", "other", "warn"],
      "properties": {
        "debug": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "error": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "info": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "other": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "warn": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "first_day": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
    "last_day": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
    "omitted_fields": {
      "const": ["arbitrary_fields", "hook_names", "message", "raw_source_lines", "session_id"]
    },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "entry_count": { "const": 0 } }, "required": ["entry_count"] },
      "then": { "properties": { "first_day": { "type": "null" }, "last_day": { "type": "null" } } }
    },
    {
      "if": { "properties": { "entry_count": { "minimum": 1 } }, "required": ["entry_count"] },
      "then": {
        "properties": {
          "first_day": { "type": "string", "format": "date" },
          "last_day": { "type": "string", "format": "date" }
        }
      }
    }
  ]
}
