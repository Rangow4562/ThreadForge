{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/codex-cli-plan-gate-hook-result-v1.schema.json",
  "title": "Threadforge Codex CLI task-plan deny-only hook result v1",
  "oneOf": [
    {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["hookSpecificOutput"],
      "properties": {
        "hookSpecificOutput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hookEventName", "permissionDecision", "permissionDecisionReason"],
          "properties": {
            "hookEventName": { "const": "PreToolUse" },
            "permissionDecision": { "const": "deny" },
            "permissionDecisionReason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  ]
}
