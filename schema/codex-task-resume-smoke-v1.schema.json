{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/codex-task-resume-smoke-v1.schema.json",
  "title": "Threadforge installed Codex task-resume smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "host_cli_version", "provider", "tool", "tool_call_count",
    "tool_result_observed", "task_context_content_retained_in_report", "advisory_result_markers_verified",
    "requirements_not_finalized_warning_verified", "action_ready", "guidance_only", "execution_authorized",
    "completion_requests", "auxiliary_completion_requests", "telemetry", "real_model_invocations"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.codex-task-resume-smoke.v1" },
    "status": { "const": "verified" },
    "host_cli_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provider": { "const": "deterministic-loopback-fixture" },
    "tool": { "const": "threadforge_task_resume_context" },
    "tool_call_count": { "const": 1 },
    "tool_result_observed": { "const": true },
    "task_context_content_retained_in_report": { "const": false },
    "advisory_result_markers_verified": { "const": true },
    "requirements_not_finalized_warning_verified": { "const": true },
    "action_ready": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false },
    "completion_requests": { "type": "integer", "minimum": 2, "maximum": 20 },
    "auxiliary_completion_requests": { "type": "integer", "minimum": 0, "maximum": 10 },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "endpoint", "log_batches", "trace_batches", "log_records", "spans",
        "local_turn_cost_posts", "user_prompt_text_detected", "approved_guidance_text_detected", "fixture_key_detected"
      ],
      "properties": {
        "status": { "const": "verified" },
        "endpoint": { "const": "loopback-only" },
        "log_batches": { "type": "integer", "minimum": 1, "maximum": 256 },
        "trace_batches": { "type": "integer", "minimum": 1, "maximum": 256 },
        "log_records": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "spans": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "local_turn_cost_posts": { "type": "integer", "minimum": 0, "maximum": 256 },
        "user_prompt_text_detected": { "const": false },
        "approved_guidance_text_detected": { "type": "boolean" },
        "fixture_key_detected": { "const": false }
      }
    },
    "real_model_invocations": { "const": 0 }
  }
}
