{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/cross-harness-procedure-capture-smoke-v1.schema.json",
  "title": "Cross-harness installed trace-backed procedure smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "capture_harness",
    "capture_host_version",
    "installed_host_events_observed",
    "prompt_event_observed",
    "tool_invocation_and_completion_observed",
    "trace_digest_bound_to_draft",
    "trace_file_removed_after_import",
    "raw_trace_content_retained",
    "procedure_text_is_synthetic_fixture",
    "procedure_approved_in_isolated_store",
    "approval_and_validation_are_synthetic_fixtures",
    "retrieval_harness",
    "retrieval_host_version",
    "installed_retrieval_verified",
    "retrieval_markers_verified",
    "authorization_grant_absent",
    "retrieval_freshness",
    "guidance_only",
    "action_ready",
    "execution_authorized",
    "validation_is_acceptance_evidence",
    "cutover_evidence_eligible",
    "real_model_invocations"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.cross-harness-procedure-capture-smoke.v1" },
    "status": { "const": "verified" },
    "capture_harness": { "const": "opencode" },
    "capture_host_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "installed_host_events_observed": { "type": "integer", "minimum": 1, "maximum": 200 },
    "prompt_event_observed": { "const": true },
    "tool_invocation_and_completion_observed": { "const": true },
    "trace_digest_bound_to_draft": { "const": true },
    "trace_file_removed_after_import": { "const": true },
    "raw_trace_content_retained": { "const": false },
    "procedure_text_is_synthetic_fixture": { "const": true },
    "procedure_approved_in_isolated_store": { "const": true },
    "approval_and_validation_are_synthetic_fixtures": { "const": true },
    "retrieval_harness": { "const": "antigravity" },
    "retrieval_host_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "installed_retrieval_verified": { "const": true },
    "retrieval_markers_verified": { "const": true },
    "authorization_grant_absent": { "const": true },
    "retrieval_freshness": { "const": "verified" },
    "guidance_only": { "const": true },
    "action_ready": { "const": false },
    "execution_authorized": { "const": false },
    "validation_is_acceptance_evidence": { "const": false },
    "cutover_evidence_eligible": { "const": false },
    "real_model_invocations": { "const": 0 }
  }
}
