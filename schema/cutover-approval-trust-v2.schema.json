{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/cutover-approval-trust-v2.schema.json",
  "title": "Threadforge trusted cutover approvers v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": { "const": "threadforge.cutover-approval-trust.v2" },
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "public_key", "reviewer_id", "roles", "not_before", "not_after"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "public_key": { "type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44 },
          "reviewer_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._@/-]{0,127}$" },
          "roles": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["release-manager", "security-reviewer", "license-reviewer", "product-name-reviewer"] } },
          "not_before": { "type": "string", "format": "date-time" },
          "not_after": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
