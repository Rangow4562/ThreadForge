{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/cutover-evaluation-trials-v1.schema.json",
  "title": "Threadforge cutover evaluation task/run outcomes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "legacy_version", "legacy_commit", "dataset_sha256", "held_out", "evaluator", "noise_calibration", "baseline_runs", "candidate_runs"],
  "properties": {
    "schema_version": { "const": "threadforge.cutover-evaluation-trials.v1" },
    "domain": { "type": "string", "minLength": 1, "maxLength": 128 },
    "legacy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "legacy_commit": { "$ref": "#/$defs/sha256_or_commit" },
    "dataset_sha256": { "$ref": "#/$defs/sha256" },
    "held_out": { "const": true },
    "evaluator": { "$ref": "#/$defs/evaluator" },
    "noise_calibration": { "$ref": "#/$defs/noise_calibration" },
    "baseline_runs": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/run" } },
    "candidate_runs": { "type": "array", "minItems": 4, "maxItems": 8, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256_or_commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "noise_calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "seed", "bootstrap_resamples", "confidence_level"],
      "properties": {
        "method": { "enum": ["paired_task_and_independent_run_bootstrap_null", "paired_task_and_independent_run_bootstrap_null_v2"] },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "bootstrap_resamples": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "confidence_level": { "type": "number", "minimum": 0.95, "maximum": 0.99 }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "tasks"],
      "properties": {
        "run_id": { "$ref": "#/$defs/sha256" },
        "tasks": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/task_outcome" } }
      }
    },
    "task_outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["task_sha256", "success", "cost_usd", "tokens"],
      "properties": {
        "task_sha256": { "$ref": "#/$defs/sha256" },
        "success": { "type": "boolean" },
        "failure_signature_sha256": { "$ref": "#/$defs/sha256" },
        "cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000000000 },
        "tokens": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "success": { "const": true } }, "required": ["success"] }, "then": { "not": { "required": ["failure_signature_sha256"] } } },
        { "if": { "properties": { "success": { "const": false } }, "required": ["success"] }, "then": { "required": ["failure_signature_sha256"] } }
      ]
    }
  }
}
