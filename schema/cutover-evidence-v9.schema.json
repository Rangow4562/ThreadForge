{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/cutover-evidence-v9.schema.json",
  "title": "Threadforge all-or-nothing cutover evidence v9",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "candidate_commit", "features", "adapters", "migrations", "cross_harness_tests", "evaluations", "approvals"],
  "properties": {
    "schema_version": { "const": "threadforge.cutover-evidence.v9" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "candidate_commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "features": { "type": "array", "items": { "$ref": "cutover-evidence-v2.schema.json#/$defs/feature" } },
    "adapters": { "type": "array", "items": { "$ref": "cutover-evidence-v2.schema.json#/$defs/adapter" } },
    "migrations": { "type": "array", "items": { "$ref": "#/$defs/migration" } },
    "cross_harness_tests": { "type": "array", "items": { "$ref": "cutover-evidence-v2.schema.json#/$defs/cross_harness" } },
    "evaluations": { "type": "array", "items": { "$ref": "cutover-evidence-v3.schema.json#/$defs/evaluation" } },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": { "$ref": "cutover-evidence-v2.schema.json#/$defs/evidence" },
    "evidence_list": { "$ref": "cutover-evidence-v2.schema.json#/$defs/evidence_list" },
    "migration_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "role", "source_fingerprint", "snapshot_sha256", "format_coverage", "source_backup_verification", "interruption_recovery_tested", "rollback_rehearsed", "evidence"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^(?:git_coordination-[a-f0-9]{64}|non_git_coordination-[a-f0-9]{64})$" },
        "role": { "enum": ["git_coordination", "non_git_coordination"] },
        "source_fingerprint": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "format_coverage": { "$ref": "#/$defs/evidence" },
        "source_backup_verification": { "$ref": "#/$defs/evidence" },
        "interruption_recovery_tested": { "type": "boolean" },
        "rollback_rehearsed": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "source_fingerprint", "snapshot_sha256", "format_coverage", "source_backup_verification", "source_records", "imported_records", "excluded_records", "unresolved_conflicts", "credential_records_migrated", "interruption_recovery_tested", "rollback_rehearsed", "evidence"],
      "properties": {
        "product": { "enum": ["beacon", "mancode", "anyjev", "rrsi"] },
        "source_fingerprint": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "format_coverage": { "$ref": "#/$defs/evidence" },
        "source_backup_verification": { "$ref": "#/$defs/evidence" },
        "mancode_source_set": { "$ref": "#/$defs/evidence" },
        "mancode_source_authority": { "$ref": "#/$defs/evidence" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/migration_source" }, "maxItems": 1023 },
        "source_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "imported_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "excluded_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "unresolved_conflicts": { "type": "integer", "minimum": 0 },
        "credential_records_migrated": { "type": "integer", "minimum": 0 },
        "interruption_recovery_tested": { "type": "boolean" },
        "rollback_rehearsed": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      },
      "allOf": [
        { "if": { "properties": { "product": { "const": "mancode" } }, "required": ["product"] }, "then": { "required": ["mancode_source_set", "mancode_source_authority"] } },
        { "if": { "properties": { "product": { "enum": ["beacon", "anyjev", "rrsi"] } }, "required": ["product"] }, "then": { "not": { "anyOf": [{ "required": ["mancode_source_set"] }, { "required": ["mancode_source_authority"] }, { "required": ["sources"] }] } } }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reviewer", "approved", "reason", "approved_at", "evidence", "attestation"],
      "properties": {
        "role": { "enum": ["release-manager", "security-reviewer", "license-reviewer"] },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approved": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/evidence_list" },
        "attestation": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
