{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/decision-artifact-import-v1.schema.json",
  "title": "Threadforge local import of one AnyJev calibration or head artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "actor", "reason", "content"],
  "properties": {
    "schema_version": { "const": "threadforge.decision-artifact-import.v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "required": ["model", "question", "method", "temperature", "n_calib"],
          "properties": {
            "model": { "type": "string", "minLength": 1, "maxLength": 512 },
            "question": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
            "method": { "const": "temperature" },
            "temperature": { "type": "number", "exclusiveMinimum": 0 },
            "n_calib": { "type": "integer", "minimum": 2, "maximum": 100000 }
          }
        },
        {
          "type": "object",
          "required": ["model", "question", "method", "question_id", "kind", "text", "options", "layer_abs", "n_blocks", "hidden_size", "temperature", "n_calib", "W", "b", "mean", "scale", "params", "cv"],
          "properties": {
            "model": { "type": "string", "minLength": 1, "maxLength": 512 },
            "question": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
            "method": { "type": "string", "pattern": "^head:(diff_means|lda|ridge|rrr)$" },
            "question_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "kind": { "enum": ["choice", "score", "noul"] },
            "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
            "options": { "type": "array", "minItems": 2, "maxItems": 26, "items": { "type": "string" } },
            "layer_abs": { "type": "integer", "minimum": 1 },
            "n_blocks": { "type": "integer", "minimum": 1 },
            "hidden_size": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number", "exclusiveMinimum": 0 },
            "n_calib": { "type": "integer", "minimum": 8, "maximum": 100000 },
            "W": { "type": "array" },
            "b": { "type": "array" },
            "mean": { "type": "array" },
            "scale": { "type": "array" },
            "params": { "type": "object" },
            "cv": { "type": "object" }
          }
        }
      ]
    }
  }
}
