{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/decision-batch-result-v1.schema.json",
  "title": "Threadforge bounded typed decision batch result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "question_key", "count", "level", "decisions", "backend", "remote_opt_in", "backend_stats"],
  "properties": {
    "schema_version": { "const": "threadforge.decision-batch-result.v1" },
    "question_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "question_key": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "count": { "type": "integer", "minimum": 1, "maximum": 128 },
    "level": { "enum": ["raw", "L0", "L1", "L2", "auto"] },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "level", "answer", "confidence"],
        "properties": {
          "kind": { "enum": ["choice", "score", "noul"] },
          "level": { "enum": ["raw", "L0", "L1", "L2"] },
          "answer": { "type": ["string", "number", "boolean"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": { "type": "number" },
          "distribution": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      }
    },
    "backend": { "type": "string", "minLength": 1 },
    "remote_opt_in": { "type": "boolean" },
    "human_review_required": { "const": true },
    "model_environment_verified": { "type": "boolean" },
    "model_checkpoint_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_authorized": { "const": false },
    "cutover_evidence_eligible": { "const": false },
    "backend_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_calls", "flat_prompts", "shared_groups", "shared_prompts", "adaptive_items", "adaptive_shifts_total"],
      "properties": {
        "backend_calls": { "type": "integer", "minimum": 0 },
        "flat_prompts": { "type": "integer", "minimum": 0 },
        "shared_groups": { "type": "integer", "minimum": 0 },
        "shared_prompts": { "type": "integer", "minimum": 0 },
        "adaptive_items": { "type": "integer", "minimum": 0 },
        "adaptive_shifts_total": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "model_environment_verified": { "const": true } }, "required": ["model_environment_verified"] },
      "then": { "required": ["model_checkpoint_sha256", "human_review_required", "execution_authorized", "cutover_evidence_eligible"], "properties": { "remote_opt_in": { "const": false } } }
    },
    {
      "if": { "properties": { "model_environment_verified": { "const": false } }, "required": ["model_environment_verified"] },
      "then": { "not": { "required": ["model_checkpoint_sha256"] } }
    }
  ]
}
