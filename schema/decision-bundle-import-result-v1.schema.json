{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/decision-bundle-import-result-v1.schema.json",
  "title": "Threadforge AnyJev native bundle import result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle", "human_review_required", "activation_allowed", "execution_authorized", "cutover_evidence_eligible"],
  "properties": {
    "schema_version": { "const": "threadforge.decision-bundle-import-result.v1" },
    "bundle": { "$ref": "decision-bundle-summary-v1.schema.json" },
    "human_review_required": { "const": true },
    "activation_allowed": { "const": false },
    "execution_authorized": { "const": false },
    "cutover_evidence_eligible": { "const": false }
  }
}
