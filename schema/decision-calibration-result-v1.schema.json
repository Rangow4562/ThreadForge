{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/decision-calibration-result-v1.schema.json",
  "title": "Threadforge AnyJev calibration candidate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "question_id", "level", "examples", "artifact",
    "human_review_required", "activation_allowed", "execution_authorized", "cutover_evidence_eligible"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.decision-calibration-result.v1" },
    "status": { "const": "calibrated" },
    "question_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "level": { "enum": ["L1", "L2"] },
    "examples": { "type": "integer", "minimum": 2, "maximum": 128 },
    "artifact": { "type": "object", "maxProperties": 64 },
    "fit_options": { "$ref": "decision-observe-request-v1.schema.json#/$defs/fit_options" },
    "human_review_required": { "const": true },
    "activation_allowed": { "const": false },
    "execution_authorized": { "const": false },
    "cutover_evidence_eligible": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "level": { "const": "L2" } }, "required": ["level"] },
      "then": { "required": ["fit_options"] },
      "else": { "not": { "required": ["fit_options"] } }
    }
  ]
}
