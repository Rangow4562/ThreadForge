{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/decision-observe-history-v1.schema.json",
  "title": "Threadforge private AnyJev observation audit history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stream_id", "history"],
  "properties": {
    "schema_version": { "const": "threadforge.decision-observe-history.v1" },
    "stream_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "history": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stream_id", "revision", "action", "actor", "reason", "created_at", "content_sha256", "observation_count", "total_fits"],
        "properties": {
          "stream_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "revision": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "action": { "enum": ["created", "updated"] },
          "actor": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "created_at": { "type": "string", "format": "date-time" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "observation_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "total_fits": { "type": "integer", "minimum": 0, "maximum": 4096 },
          "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        }
      }
    }
  }
}
