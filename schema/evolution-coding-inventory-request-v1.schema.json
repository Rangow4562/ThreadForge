{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-coding-inventory-request-v1.schema.json",
  "title": "Threadforge local RRSI coding inventory bundle request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "params"],
  "properties": {
    "schema_version": { "const": "threadforge.evolution-coding-inventory-request.v1" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rrsi_source_root", "swe_bench_dataset_file"],
      "properties": {
        "rrsi_source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Absolute local root of the pinned RRSI checkout used for Terminal-Bench. Never returned."
        },
        "swe_bench_dataset_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Absolute local path to the exact pinned SWE-bench Verified Parquet file. Never returned."
        }
      }
    }
  }
}
