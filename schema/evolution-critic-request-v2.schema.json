{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-critic-request-v2.schema.json",
  "title": "Threadforge source-verified local RRSI critic request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "diff", "summary", "targets_mode", "edits", "backend"],
  "properties": {
    "schema_version": {"const": "threadforge.evolution-critic-request.v2"},
    "domain": {"enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]},
    "diff": {"type": "string", "minLength": 1, "maxLength": 120000},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "targets_mode": {"type": "string", "minLength": 1, "maxLength": 2000},
    "edits": {"type": "array", "minItems": 1, "maxItems": 80, "items": {"$ref": "#/$defs/edit"}},
    "state_files": {"type": "string", "maxLength": 20000},
    "denied_literals": {
      "type": "array", "maxItems": 512,
      "items": {"type": "object", "additionalProperties": false, "required": ["literal", "reason"], "properties": {"literal": {"type": "string", "minLength": 1, "maxLength": 256}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}}}
    },
    "benchmark_task_ids": {"type": "array", "maxItems": 2048, "items": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"}},
    "benchmark_inventories": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/inventory"}},
    "backend": {"type": "object", "additionalProperties": false, "required": ["type", "model_path"], "properties": {"type": {"const": "hf"}, "model_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "device": {"type": "string", "pattern": "^(cpu|mps|cuda(:[0-9]+)?)$"}, "dtype": {"enum": ["auto", "float32", "float16", "bfloat16"]}}}
  },
  "$defs": {
    "edit": {"type": "object", "additionalProperties": false, "required": ["component"], "properties": {"id": {"type": "string", "maxLength": 128}, "component": {"enum": ["prompt", "control_flow", "config", "output_plumbing", "context_mgmt", "client_tool", "skill", "memory", "subagent"]}, "hypothesis": {"type": "string", "maxLength": 4000}, "mechanism": {"type": "string", "maxLength": 4000}, "targets_mode": {"type": "string", "maxLength": 2000}, "predicted_affected": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 128}}, "why_not_lower_lever": {"type": "string", "maxLength": 2000}, "trigger_condition": {"type": "string", "maxLength": 2000}, "retroactive_check": {"type": "string", "maxLength": 4000}, "regression_risk": {"type": "string", "maxLength": 2000}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_revision", "source_file_sha256", "task_ids"], "properties": {"source_id": {"enum": ["terminal-bench/terminal-bench-2-1", "engdesign-open", "engdesign-v1"]}, "source_revision": {"const": "be50316e1db05914068a973f322770ef08ed7ba1"}, "source_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "task_ids": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"}}}}
  }
}
