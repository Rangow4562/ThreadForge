{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-domain-inventory-bundle-v1.schema.json",
  "title": "Threadforge private RRSI domain inventory bundle v1",
  "description": "Local task identifiers and provenance for an anchored evolve and held-out split pair. Do not commit benchmark IDs or task data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "benchmark_inventories"],
  "properties": {
    "schema_version": { "const": "threadforge.rrsi-domain-inventory-bundle.v1" },
    "domain": {
      "enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]
    },
    "benchmark_inventories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_revision", "source_file_sha256", "task_ids"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "source_file_sha256": { "$ref": "#/$defs/sha256" },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": { "type": "string", "minLength": 3, "maxLength": 128 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
