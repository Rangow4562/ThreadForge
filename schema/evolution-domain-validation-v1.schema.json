{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-domain-validation-v1.schema.json",
  "title": "Threadforge RRSI domain result validation response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "status", "expected_splits", "splits", "missing_evidence", "acceptance_status", "benchmark_execution_performed", "human_approval_required", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.rrsi-domain-validation.v1" },
    "domain": { "enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"] },
    "status": { "enum": ["validated", "incomplete", "privacy_blocked"] },
    "expected_splits": { "type": "array", "items": { "type": "string" } },
    "splits": { "type": "array", "items": { "$ref": "#/$defs/split" } },
    "missing_evidence": { "type": "array", "items": { "$ref": "#/$defs/missing" } },
    "acceptance_status": { "const": "not_evaluated" },
    "benchmark_execution_performed": { "const": false },
    "human_approval_required": { "const": true },
    "execution_authorized": { "const": false }
  },
  "$defs": {
    "missing": {
      "type": "object", "additionalProperties": false,
      "required": ["split_id", "item"],
      "properties": { "split_id": { "type": "string" }, "item": { "type": "string" } }
    },
    "run_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["run_count", "metrics_mean"],
      "properties": {
        "run_count": { "type": "integer", "minimum": 0 },
        "metrics_mean": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["split_id", "roles", "baseline", "candidate"],
      "properties": {
        "split_id": { "type": "string" },
        "roles": { "type": "array", "items": { "enum": ["evolve", "held_out", "ood"] } },
        "dataset_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "task_count": { "type": "integer", "minimum": 1 },
        "evaluator": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "id": { "type": "string" }, "version": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "baseline": { "$ref": "#/$defs/run_summary" },
        "candidate": { "$ref": "#/$defs/run_summary" }
      }
    }
  }
}
