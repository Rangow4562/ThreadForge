{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-domain-verification-request-v1.schema.json",
  "title": "Threadforge local RRSI domain artifact verification request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "params"],
  "properties": {
    "schema_version": { "const": "threadforge.evolution-domain-verification-request.v1" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "evidence_root", "splits"],
      "properties": {
        "domain": { "enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"] },
        "evidence_root": {
          "type": "string", "minLength": 1, "maxLength": 4096,
          "description": "Absolute local directory containing the referenced evidence files. This path is never returned."
        },
        "splits": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["split_id", "roles"],
            "properties": {
              "split_id": {
                "enum": [
                  "terminal-bench/terminal-bench-2-1", "swe-bench/swe-bench-verified",
                  "harvey-lab/evolve", "harvey-lab/held-out", "jobbench", "gdpval", "apex-agents",
                  "engdesign-open", "engdesign-v1", "frontier-eng"
                ]
              },
              "roles": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "enum": ["evolve", "held_out", "ood"] }
              },
              "dataset_artifact": { "$ref": "#/$defs/dataset_artifact" },
              "evaluator": { "$ref": "#/$defs/evaluator_artifact" },
              "baseline_runs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/artifact_reference" } },
              "candidate_runs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/artifact_reference" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "artifact_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dataset_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256", "task_count"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "task_count": { "type": "integer", "minimum": 1 }
      }
    },
    "evaluator_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "relative_path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "relative_path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
