{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-domain-verification-request-v2.schema.json",
  "title": "Threadforge source-bound local RRSI domain verification request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "params"],
  "properties": {
    "schema_version": { "const": "threadforge.evolution-domain-verification-request.v2" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "evidence_root", "splits", "benchmark_inventories"],
      "properties": {
        "domain": { "enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"] },
        "evidence_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "benchmark_inventories": {
          "type": "array", "maxItems": 8,
          "items": { "$ref": "#/$defs/inventory" }
        },
        "splits": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["split_id", "roles", "task_set_sha256"],
            "properties": {
              "split_id": { "enum": [
                "terminal-bench/terminal-bench-2-1", "swe-bench/swe-bench-verified",
                "harvey-lab/evolve", "harvey-lab/held-out", "jobbench", "gdpval", "apex-agents",
                "engdesign-open", "engdesign-v1", "frontier-eng"
              ] },
              "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["evolve", "held_out", "ood"] } },
              "task_set_sha256": { "$ref": "#/$defs/sha256" },
              "dataset_artifact": { "$ref": "evolution-domain-verification-request-v1.schema.json#/$defs/dataset_artifact" },
              "evaluator": { "$ref": "evolution-domain-verification-request-v1.schema.json#/$defs/evaluator_artifact" },
              "baseline_runs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/artifact_reference" } },
              "candidate_runs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/artifact_reference" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_revision", "source_file_sha256", "task_ids"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_file_sha256": { "$ref": "#/$defs/sha256" },
        "task_ids": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "type": "string", "minLength": 3, "maxLength": 128 } }
      }
    }
  }
}
