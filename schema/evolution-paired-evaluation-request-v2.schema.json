{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-paired-evaluation-request-v2.schema.json",
  "title": "Threadforge paired held-out evaluation request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "params"],
  "properties": {
    "schema_version": { "const": "threadforge.evolution-paired-evaluation-request.v2" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "split_role", "dataset_sha256", "evaluator", "config_hashes", "cost_unit", "baseline_runs", "candidate_runs", "thresholds"],
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/identifier" },
        "split_role": { "const": "held_out" },
        "dataset_sha256": { "$ref": "#/$defs/sha256" },
        "evaluator": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "config_hashes": {
          "type": "object", "additionalProperties": false, "required": ["baseline", "candidate"],
          "properties": { "baseline": { "$ref": "#/$defs/sha256" }, "candidate": { "$ref": "#/$defs/sha256" } }
        },
        "cost_unit": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,31}$" },
        "baseline_runs": { "$ref": "#/$defs/baseline_runs" },
        "candidate_runs": { "$ref": "#/$defs/candidate_runs" },
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["confidence_level", "bootstrap_resamples", "seed", "max_cost_overhead_pct", "max_token_overhead_pct"],
          "properties": {
            "confidence_level": { "type": "number", "minimum": 0.95, "maximum": 0.99 },
            "bootstrap_resamples": { "type": "integer", "minimum": 100, "maximum": 10000 },
            "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "max_cost_overhead_pct": { "type": "number", "minimum": 0 },
            "max_token_overhead_pct": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "repeated_failures", "success", "cost", "tokens"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
        "repeated_failures": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "success": { "type": "boolean" },
        "cost": { "type": "number", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "seed", "evidence_sha256", "tasks"],
      "properties": {
        "run_id": { "$ref": "#/$defs/identifier" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "tasks": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/task" } }
      }
    },
    "baseline_runs": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/run" } },
    "candidate_runs": { "type": "array", "minItems": 4, "maxItems": 8, "items": { "$ref": "#/$defs/run" } }
  }
}
