{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-repair-request-v1.schema.json",
  "title": "Threadforge bounded local RRSI repair request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "candidate", "backend"],
  "properties": {
    "schema_version": {"const": "threadforge.evolution-repair-request.v1"},
    "domain": {"enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]},
    "candidate": {"$ref": "#/$defs/candidate"},
    "max_repairs": {"type": "integer", "minimum": 0, "maximum": 2, "default": 1},
    "denied_literals": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["literal", "reason"],
        "properties": {
          "literal": {"type": "string", "minLength": 1, "maxLength": 256},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "benchmark_task_ids": {
      "type": "array", "maxItems": 2048,
      "items": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$" }
    },
    "backend": {
      "type": "object", "additionalProperties": false, "required": ["type", "model_path"],
      "properties": {
        "type": {"const": "hf"}, "model_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "device": {"type": "string", "pattern": "^(cpu|mps|cuda(:[0-9]+)?)$"},
        "dtype": {"enum": ["auto", "float32", "float16", "bfloat16"]}
      }
    }
  },
  "$defs": {
    "edit": {
      "type": "object", "additionalProperties": false, "required": ["component"],
      "properties": {
        "id": {"type": "string", "maxLength": 128},
        "component": {"enum": ["prompt", "control_flow", "config", "output_plumbing", "context_mgmt", "client_tool", "skill", "memory", "subagent"]},
        "hypothesis": {"type": "string", "maxLength": 4000}, "mechanism": {"type": "string", "maxLength": 4000},
        "targets_mode": {"type": "string", "maxLength": 2000},
        "predicted_affected": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 128}},
        "why_not_lower_lever": {"type": "string", "maxLength": 2000}, "trigger_condition": {"type": "string", "maxLength": 2000},
        "retroactive_check": {"type": "string", "maxLength": 4000}, "regression_risk": {"type": "string", "maxLength": 2000}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "targets_mode", "edits", "diff"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "targets_mode": {"type": "string", "minLength": 1, "maxLength": 2000},
        "edits": {"type": "array", "minItems": 1, "maxItems": 80, "items": {"$ref": "#/$defs/edit"}},
        "diff": {"type": "string", "minLength": 1, "maxLength": 16384},
        "state_files": {"type": "string", "maxLength": 4000}
      }
    }
  }
}
