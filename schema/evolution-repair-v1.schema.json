{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-repair-v1.schema.json",
  "title": "Threadforge bounded RRSI repair result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "domain", "status", "reason_code", "action_ready", "candidate", "candidate_sha256", "attempt_history", "attempt_count", "repair_count", "final_critic", "human_approval_required", "evaluation_required", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "threadforge.evolution-repair.v1"},
    "domain": {"enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]},
    "status": {"enum": ["reviewed", "blocked", "incomplete", "privacy_blocked"]},
    "reason_code": {"enum": ["local_critic_accept", "local_critic_reject", "deterministic_screen_block", "credential_material", "local_hf_backend_required", "local_model_unavailable", "unsafe_repair_output", "invalid_repair_output", "no_safe_repair", "repair_loop_exhausted", "invalid_analyst_output", "unsafe_analyst_output"]},
    "action_ready": {"const": false},
    "candidate": {"oneOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "candidate_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "attempt_history": {"type": "array", "minItems": 0, "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
    "attempt_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "final_critic": {"oneOf": [{"$ref": "#/$defs/critic"}, {"type": "null"}]},
    "human_approval_required": {"const": true},
    "evaluation_required": {"const": true},
    "execution_authorized": {"const": false}
  },
  "$defs": {
    "edit": {
      "type": "object", "additionalProperties": false, "required": ["component"],
      "properties": {
        "id": {"type": "string", "maxLength": 128}, "component": {"enum": ["prompt", "control_flow", "config", "output_plumbing", "context_mgmt", "client_tool", "skill", "memory", "subagent"]},
        "hypothesis": {"type": "string", "maxLength": 4000}, "mechanism": {"type": "string", "maxLength": 4000}, "targets_mode": {"type": "string", "maxLength": 2000},
        "predicted_affected": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 128}}, "why_not_lower_lever": {"type": "string", "maxLength": 2000},
        "trigger_condition": {"type": "string", "maxLength": 2000}, "retroactive_check": {"type": "string", "maxLength": 4000}, "regression_risk": {"type": "string", "maxLength": 2000}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["summary", "targets_mode", "edits", "diff", "state_files"],
      "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "targets_mode": {"type": "string", "minLength": 1, "maxLength": 2000}, "edits": {"type": "array", "minItems": 1, "maxItems": 80, "items": {"$ref": "#/$defs/edit"}}, "diff": {"type": "string", "minLength": 1, "maxLength": 16384}, "state_files": {"type": "string", "maxLength": 4000}}
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "candidate_sha256", "summary", "targets_mode", "edit_metadata", "status", "verdict", "reason_code", "findings", "matched_domain_rule_ids", "analyst_review", "repair_generated"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "summary": {"type": "string", "maxLength": 2000}, "targets_mode": {"type": "string", "maxLength": 2000},
        "edit_metadata": {"type": "array", "maxItems": 80, "items": {"$ref": "#/$defs/edit"}},
        "status": {"enum": ["reviewed", "blocked", "incomplete", "privacy_blocked"]},
        "verdict": {"enum": ["accept", "reject", null]},
        "reason_code": {"enum": ["deterministic_screen_block", "credential_material", "local_hf_backend_required", "local_model_unavailable", "unsafe_model_output", "invalid_critic_output", "local_critic_accept", "local_critic_reject"]},
        "findings": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}},
        "matched_domain_rule_ids": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}},
        "analyst_review": {"$ref": "#/$defs/analyst_review"},
        "repair_generated": {"type": "boolean"}
      }
    },
    "analyst_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason_code", "risk_level", "risk_categories", "validation_gaps"],
      "properties": {
        "status": {"enum": ["reviewed", "skipped", "incomplete", "privacy_blocked"]},
        "reason_code": {"enum": ["local_analyst_review", "deterministic_screen_block", "local_model_unavailable", "invalid_analyst_output", "unsafe_analyst_output"]},
        "risk_level": {"enum": ["unknown", "low", "medium", "high"]},
        "risk_categories": {"type": "array", "uniqueItems": true, "maxItems": 8, "items": {"enum": ["benchmark_specialization", "grader_access", "secret_handling", "authority_change", "unbounded_work", "state_leakage", "regression_surface", "unclear_mechanism"]}},
        "validation_gaps": {"type": "array", "uniqueItems": true, "maxItems": 5, "items": {"enum": ["structural_tests", "held_out_evaluation", "noise_calibration", "cost_token_measurement", "cross_harness_test"]}}
      }
    },
    "critic": {
      "type": "object", "additionalProperties": false, "required": ["status", "verdict", "reason_code", "findings", "matched_domain_rule_ids"],
      "properties": {"status": {"enum": ["reviewed", "blocked", "incomplete", "privacy_blocked"]}, "verdict": {"enum": ["accept", "reject", null]}, "reason_code": {"type": "string", "maxLength": 64}, "findings": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}}, "matched_domain_rule_ids": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}}}
    }
  }
}
