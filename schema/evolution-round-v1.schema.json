{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schema/evolution-round-v1.schema.json",
  "title": "Threadforge RRSI selection history round",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "domain", "created_at", "incumbent", "s_star", "delta", "selection_config", "incumbent_counts", "candidates", "selected_id", "keep_incumbent", "review_status", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "threadforge.evolution-round.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "domain": {"enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]},
    "created_at": {"type": "string", "format": "date-time"},
    "incumbent": {"$ref": "#/$defs/evaluation"},
    "s_star": {"type": "number", "minimum": 0, "maximum": 1},
    "delta": {"type": "number", "minimum": 0, "maximum": 1},
    "selection_config": {
      "type": "object", "additionalProperties": false,
      "required": ["beta0", "beta1", "w_s", "w_c", "w_n"],
      "properties": {
        "beta0": {"type": "number", "minimum": 0}, "beta1": {"type": "number", "minimum": 0},
        "w_s": {"type": "number", "minimum": 0}, "w_c": {"type": "number", "minimum": 0},
        "w_n": {"type": "number", "minimum": 0}
      }
    },
    "incumbent_counts": {
      "type": "object",
      "propertyNames": {"enum": ["prompt", "control_flow", "config", "output_plumbing", "context_mgmt", "client_tool", "skill", "memory", "subagent"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "candidates": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/candidate"}},
    "selected_id": {"type": ["string", "null"], "maxLength": 128},
    "keep_incumbent": {"type": "boolean"},
    "review_status": {"const": "pending_human_review"},
    "execution_authorized": {"const": false}
  },
  "$defs": {
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["score", "cost"],
      "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}, "cost": {"type": "number", "exclusiveMinimum": 0}}
    },
    "edit": {
      "type": "object", "additionalProperties": false, "required": ["component"],
      "properties": {
        "id": {"type": "string", "maxLength": 128},
        "component": {"enum": ["prompt", "control_flow", "config", "output_plumbing", "context_mgmt", "client_tool", "skill", "memory", "subagent"]},
        "hypothesis": {"type": "string", "maxLength": 4000},
        "mechanism": {"type": "string", "maxLength": 4000},
        "targets_mode": {"type": "string", "maxLength": 2000},
        "predicted_affected": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 128}},
        "why_not_lower_lever": {"type": "string", "maxLength": 2000},
        "trigger_condition": {"type": "string", "maxLength": 2000},
        "retroactive_check": {"type": "string", "maxLength": 4000},
        "regression_risk": {"type": "string", "maxLength": 2000}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["variant", "admissible", "reason", "novelty"],
      "properties": {
        "variant": {"type": "string", "maxLength": 128},
        "admissible": {"type": "boolean"}, "reason": {"type": "string", "maxLength": 2000},
        "S": {"type": "number", "minimum": 0, "maximum": 1}, "C": {"type": "number", "exclusiveMinimum": 0},
        "delta_S": {"type": "number"}, "delta_C": {"type": "number"}, "novelty": {"type": "integer", "minimum": 0},
        "guards": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 1000}}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "measured", "edits", "decision", "outcome"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "diff": {"type": "string", "maxLength": 120000},
        "measured": {"type": "boolean"}, "evaluation": {"$ref": "#/$defs/evaluation"},
        "gate_failure": {"type": "string", "maxLength": 1000}, "detail": {"type": "string", "maxLength": 1000},
        "edits": {"type": "array", "maxItems": 80, "items": {"$ref": "#/$defs/edit"}},
        "decision": {"$ref": "#/$defs/decision"},
        "outcome": {"enum": ["selected_pending_review", "lost", "rejected", "unmeasured"]}
      },
      "allOf": [
        {"if": {"properties": {"measured": {"const": true}}}, "then": {"required": ["evaluation"]}},
        {"if": {"properties": {"measured": {"const": false}}}, "then": {"not": {"required": ["evaluation"]}}}
      ]
    }
  }
}
