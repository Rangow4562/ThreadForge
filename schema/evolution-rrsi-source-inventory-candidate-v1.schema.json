{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-rrsi-source-inventory-candidate-v1.schema.json",
  "title": "Threadforge locally derived RRSI source inventory candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "source_id", "source_revision", "source_file",
    "source_file_sha256", "source_relationship_file", "source_relationship_file_sha256",
    "inventory_commitment", "benchmark_inventory", "trust_anchor_status", "screening_usable",
    "benchmark_execution_performed", "cutover_evidence_eligible", "execution_authorized"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.rrsi-source-inventory-candidate.v1" },
    "status": { "enum": ["candidate_unanchored", "candidate_source_verified"] },
    "source_id": { "$ref": "#/$defs/sourceId" },
    "source_revision": { "$ref": "#/$defs/revision" },
    "source_file": { "$ref": "#/$defs/sourceFile" },
    "source_file_sha256": { "$ref": "#/$defs/sha256" },
    "source_relationship_file": {
      "oneOf": [
        { "type": "null" },
        { "const": "domains/eng/scripts/build_testsurfaces.sh" }
      ]
    },
    "source_relationship_file_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "inventory_commitment": { "$ref": "#/$defs/commitment" },
    "benchmark_inventory": { "$ref": "#/$defs/inventory" },
    "trust_anchor_status": { "enum": ["uncommitted", "committed"] },
    "screening_usable": { "type": "boolean" },
    "benchmark_execution_performed": { "const": false },
    "cutover_evidence_eligible": { "const": false },
    "execution_authorized": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceId": {
      "enum": ["terminal-bench/terminal-bench-2-1", "engdesign-open", "engdesign-v1", "frontier-eng"]
    },
    "sourceFile": {
      "enum": [
        "domains/coding/data/tb21_tasks.txt",
        "domains/eng/data/split_engd.json",
        "benchmarks/frontier-eval-task-manifest.v1"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "task_count", "task_ids_sha256"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "task_count": { "type": "integer", "minimum": 1, "maximum": 500 },
        "task_ids_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_revision", "source_file_sha256", "task_ids"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "source_revision": { "$ref": "#/$defs/revision" },
        "source_file_sha256": { "$ref": "#/$defs/sha256" },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/taskId" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "candidate_unanchored" } }, "required": ["status"] },
      "then": {
        "properties": {
          "trust_anchor_status": { "const": "uncommitted" },
          "screening_usable": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "candidate_source_verified" } }, "required": ["status"] },
      "then": {
        "properties": {
          "trust_anchor_status": { "const": "committed" },
          "screening_usable": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "source_id": { "const": "engdesign-v1" } }, "required": ["source_id"] },
      "then": {
        "properties": {
          "source_file": { "const": "domains/eng/data/split_engd.json" },
          "source_relationship_file": { "const": "domains/eng/scripts/build_testsurfaces.sh" },
          "source_relationship_file_sha256": { "$ref": "#/$defs/sha256" }
        },
        "required": ["source_relationship_file", "source_relationship_file_sha256"]
      },
      "else": {
        "properties": {
          "source_relationship_file": { "type": "null" },
          "source_relationship_file_sha256": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "source_id": { "const": "terminal-bench/terminal-bench-2-1" } }, "required": ["source_id"] },
      "then": { "properties": { "source_file": { "const": "domains/coding/data/tb21_tasks.txt" } } },
      "else": {
        "if": { "properties": { "source_id": { "const": "frontier-eng" } }, "required": ["source_id"] },
        "then": { "properties": { "source_file": { "const": "benchmarks/frontier-eval-task-manifest.v1" } } },
        "else": { "properties": { "source_file": { "const": "domains/eng/data/split_engd.json" } } }
      }
    },
    {
      "properties": {
        "inventory_commitment": {
          "properties": { "source_id": { "$ref": "#/$defs/sourceId" } }
        },
        "benchmark_inventory": {
          "properties": { "source_id": { "$ref": "#/$defs/sourceId" } }
        }
      }
    }
  ]
}
