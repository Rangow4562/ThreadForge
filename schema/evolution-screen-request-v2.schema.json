{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-screen-request-v2.schema.json",
  "title": "Threadforge source-verified RRSI leakage screen request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "diff"],
  "properties": {
    "schema_version": {"const": "threadforge.evolution-screen-request.v2"},
    "domain": {"enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]},
    "diff": {"type": "string", "minLength": 1, "maxLength": 120000},
    "denied_literals": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["literal", "reason"],
        "properties": {
          "literal": {"type": "string", "minLength": 1, "maxLength": 256},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "benchmark_task_ids": {
      "type": "array", "maxItems": 2048,
      "items": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"}
    },
    "benchmark_inventories": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_revision", "source_file_sha256", "task_ids"],
        "properties": {
          "source_id": {"enum": ["terminal-bench/terminal-bench-2-1", "engdesign-open", "engdesign-v1"]},
          "source_revision": {"const": "be50316e1db05914068a973f322770ef08ed7ba1"},
          "source_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "task_ids": {
            "type": "array", "minItems": 1, "maxItems": 2048,
            "items": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"}
          }
        }
      }
    }
  }
}
