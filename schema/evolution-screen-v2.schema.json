{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/evolution-screen-v2.schema.json",
  "title": "Threadforge source-verified RRSI leakage screen result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "status", "action_ready", "findings", "matched_rule_indices", "matched_domain_rule_ids", "component", "domain_rules_loaded", "domain_rules_complete", "domain_rule_set_version", "verified_inventory_sources", "missing_inventory_sources", "requires_critic_review"],
  "properties": {
    "schema_version": {"const": "threadforge.evolution-screen.v2"},
    "domain": {"enum": ["rrsi-coding", "rrsi-agentic-workspace", "rrsi-engineering-design"]},
    "status": {"enum": ["blocked", "incomplete", "clear", "privacy_blocked"]},
    "action_ready": {"const": false},
    "findings": {"type": "array", "items": {"type": "string", "maxLength": 128}},
    "matched_rule_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "matched_domain_rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}},
    "component": {"enum": ["prompt", "control_flow", "config", "output_plumbing", "context_mgmt", "client_tool", "skill", "memory", "subagent", "unknown"]},
    "domain_rules_loaded": {"const": true},
    "domain_rules_complete": {"type": "boolean"},
    "domain_rule_set_version": {"enum": ["rrsi-domain-rules.v2", "rrsi-domain-rules.v3"]},
    "verified_inventory_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["terminal-bench/terminal-bench-2-1", "engdesign-open", "engdesign-v1"]}},
    "missing_inventory_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "requires_critic_review": {"const": true}
  }
}
