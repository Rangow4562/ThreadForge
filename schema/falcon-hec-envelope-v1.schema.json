{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/falcon-hec-envelope-v1.schema.json",
  "title": "Threadforge metadata-only Falcon HEC envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "time",
    "event",
    "source",
    "sourcetype"
  ],
  "properties": {
    "time": {
      "type": "number",
      "minimum": 0
    },
    "event": {
      "$ref": "metadata-export-v1.schema.json"
    },
    "source": {
      "const": "threadforge-endpoint-agent"
    },
    "sourcetype": {
      "const": "threadforge:metadata:json"
    },
    "index": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
