{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/handoff-resume-plan-v1.schema.json",
  "title": "Threadforge Handoff Resume Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "source",
    "target",
    "executable",
    "args",
    "directory"
  ],
  "properties": {
    "schema_version": {
      "const": "threadforge.handoff-resume-plan.v1"
    },
    "mode": {
      "enum": ["native", "new_session"]
    },
    "reason": {
      "enum": [
        "session_not_reopenable",
        "runtime_log_only",
        "other_runtime",
        "requested_new_session"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "harness",
        "updated_at",
        "event_count",
        "prompt_count",
        "command_count",
        "file_change_count",
        "tool_event_count"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "harness": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
        "directory": {"type": "string", "maxLength": 4096},
        "directory_conflict": {"type": "boolean"},
        "branch": {"type": "string", "maxLength": 256},
        "branch_conflict": {"type": "boolean"},
        "started_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "event_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "prompt_count": {"type": "integer", "minimum": 0},
        "command_count": {"type": "integer", "minimum": 0},
        "file_change_count": {"type": "integer", "minimum": 0},
        "tool_event_count": {"type": "integer", "minimum": 0}
      }
    },
    "target": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
    "executable": {"type": "string", "minLength": 1, "maxLength": 4096},
    "args": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 32768}
    },
    "directory": {"type": "string", "minLength": 1, "maxLength": 4096},
    "brief_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "link_status": {
      "enum": ["same_native_session", "marker_emitted_unverified", "marker_unavailable"]
    },
    "env": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
      "additionalProperties": {"type": "string", "maxLength": 1024}
    }
  }
}
