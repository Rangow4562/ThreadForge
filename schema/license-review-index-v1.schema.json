{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/license-review-index-v1.schema.json",
  "title": "Threadforge License Review Index v1",
  "description": "Target-preserving reviewer index derived from a provenance-verified candidate. It is evidence only and never grants legal or release clearance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "review_status",
    "license_review_required",
    "automated_license_inference_performed",
    "release_clearance",
    "release_authorized",
    "summary",
    "profiles",
    "python_observations",
    "go_observations",
    "go_notice_files",
    "python_cross_profile_variance",
    "go_cross_target_variance",
    "review_instructions"
  ],
  "properties": {
    "schema": {"const": "threadforge.license-review-index.v1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "source_commit",
        "source_ref",
        "checksums_sha256",
        "evidence_archive_count",
        "payload_count",
        "slsa_attestations_verified",
        "archive_sbom_attestations_verified",
        "integrity_verified",
        "provenance_verified"
      ],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_ref": {"type": "string", "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$"},
        "checksums_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_archive_count": {"const": 16},
        "payload_count": {"const": 27},
        "slsa_attestations_verified": {"const": 28},
        "archive_sbom_attestations_verified": {"const": 4},
        "integrity_verified": {"const": true},
        "provenance_verified": {"const": true}
      }
    },
    "review_status": {"const": "unreviewed"},
    "license_review_required": {"const": true},
    "automated_license_inference_performed": {"const": false},
    "release_clearance": {"const": false},
    "release_authorized": {"const": false},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_profile_count",
        "python_observation_count",
        "python_unique_package_version_count",
        "python_observations_without_expression",
        "python_observations_without_license_files",
        "go_profile_count",
        "go_observation_count",
        "go_unique_package_count",
        "go_notice_file_count",
        "python_cross_profile_variance_group_count",
        "go_cross_target_variance_group_count"
      ],
      "properties": {
        "python_profile_count": {"const": 12},
        "python_observation_count": {"type": "integer", "minimum": 1, "maximum": 120000},
        "python_unique_package_version_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "python_observations_without_expression": {"type": "integer", "minimum": 0, "maximum": 120000},
        "python_observations_without_license_files": {"type": "integer", "minimum": 0, "maximum": 120000},
        "go_profile_count": {"const": 4},
        "go_observation_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "go_unique_package_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "go_notice_file_count": {"type": "integer", "minimum": 0, "maximum": 40000},
        "python_cross_profile_variance_group_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "go_cross_target_variance_group_count": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "archive", "reviewer_archive_path", "archive_sha256", "unreviewed"],
        "properties": {
          "profile": {"type": "string", "minLength": 1, "maxLength": 64},
          "archive": {"type": "string", "pattern": "^threadforge_[A-Za-z0-9._-]+\\.tar\\.gz$"},
          "reviewer_archive_path": {"type": "string", "pattern": "^evidence/threadforge_.+\\.tar\\.gz$"},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "distribution_count": {"type": "integer", "minimum": 1, "maximum": 10000},
          "without_expression_count": {"type": "integer", "minimum": 0, "maximum": 10000},
          "without_license_file_count": {"type": "integer", "minimum": 0, "maximum": 10000},
          "license_record_count": {"type": "integer", "minimum": 1, "maximum": 10000},
          "notice_file_count": {"type": "integer", "minimum": 0, "maximum": 10000},
          "unreviewed": {"const": true}
        }
      }
    },
    "python_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "archive",
          "archive_sha256",
          "name",
          "normalized_name",
          "version",
          "locked",
          "metadata_file_sha256",
          "license_expression",
          "license_expression_status",
          "license_expression_sha256",
          "license_classifiers",
          "license_classifier_metadata_malformed",
          "license_metadata_malformed",
          "legacy_license_field_byte_count",
          "legacy_license_field_sha256",
          "license_files"
        ],
        "properties": {
          "profile": {"type": "string", "pattern": "^python/(linux|windows|darwin)/3\\.(11|12|13|14)$"},
          "archive": {"type": "string", "minLength": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 255},
          "normalized_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 255},
          "locked": {"type": "boolean"},
          "metadata_file_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "license_expression": {"type": ["string", "null"], "maxLength": 1024},
          "license_expression_status": {"enum": ["missing", "captured_unreviewed", "omitted_unsafe_metadata"]},
          "license_expression_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "license_classifiers": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 256}},
          "license_classifier_metadata_malformed": {"type": "boolean"},
          "license_metadata_malformed": {"type": "boolean"},
          "legacy_license_field_byte_count": {"type": "integer", "minimum": 0, "maximum": 4194304},
          "legacy_license_field_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "license_files": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["archive_member", "path", "sha256", "size_bytes"],
              "properties": {
                "archive_member": {"type": "string", "pattern": "^python-license-evidence/licenses/.+"},
                "path": {"type": "string", "minLength": 1, "maxLength": 4096},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
              }
            }
          }
        }
      }
    },
    "go_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "archive", "archive_sha256", "package", "license_url", "license_expression"],
        "properties": {
          "target": {"enum": ["linux_amd64", "darwin_amd64", "darwin_arm64", "windows_amd64"]},
          "archive": {"type": "string", "minLength": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "package": {"type": "string", "minLength": 1, "maxLength": 4096},
          "license_url": {"type": "string", "maxLength": 8192},
          "license_expression": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "go_notice_files": {
      "type": "array",
      "maxItems": 40000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "archive", "archive_sha256", "archive_member", "path", "sha256", "size_bytes"],
        "properties": {
          "target": {"enum": ["linux_amd64", "darwin_amd64", "darwin_arm64", "windows_amd64"]},
          "archive": {"type": "string", "minLength": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "archive_member": {"type": "string", "pattern": "^go-license-evidence/licenses/.+"},
          "path": {"type": "string", "minLength": 1, "maxLength": 8192},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
        }
      }
    },
    "python_cross_profile_variance": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["normalized_name", "version", "differing_fields", "observations", "meaning"],
        "properties": {
          "normalized_name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "differing_fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"enum": ["license_expression", "license_expression_status", "license_classifiers", "license_classifier_metadata_malformed", "license_metadata_malformed", "legacy_license_field_byte_count", "legacy_license_field_sha256", "license_files"]}
          },
          "observations": {"type": "array", "minItems": 2, "maxItems": 120000},
          "meaning": {"const": "raw observations differ; reviewer determination required"}
        }
      }
    },
    "go_cross_target_variance": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "observations", "meaning"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "observations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "licenses"],
              "properties": {
                "target": {"enum": ["linux_amd64", "darwin_amd64", "darwin_arm64", "windows_amd64"]},
                "licenses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["license_url", "license_expression"],
                    "properties": {
                      "license_url": {"type": "string", "maxLength": 8192},
                      "license_expression": {"type": "string", "minLength": 1, "maxLength": 1024}
                    }
                  }
                }
              }
            }
          },
          "meaning": {"const": "license rows differ across targets; reviewer determination required"}
        }
      }
    },
    "review_instructions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
