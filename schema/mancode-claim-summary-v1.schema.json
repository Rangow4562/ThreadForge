{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-claim-summary-v1.schema.json",
  "title": "Threadforge Mancode claim migration summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority", "human_review_required", "execution_authorized",
    "source_id_sha256", "workspace_id_sha256", "task_reference_sha256", "source_state",
    "revision", "task_revision_at_acquire", "last_validated_task_revision", "ownership_epoch_at_acquire",
    "path_scope_count", "module_scope_count", "api_scope_count", "schema_scope_count",
    "scope_digest_present", "code_baseline_present", "expires_at", "created_at", "updated_at",
    "raw_actor_identity_omitted", "raw_scope_values_omitted", "source_authority_omitted"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-claim-summary.v1" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "source_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_reference_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_state": { "enum": ["pending", "active", "released", "expired"] },
    "revision": { "type": "integer", "minimum": 1 },
    "task_revision_at_acquire": { "type": "integer", "minimum": 1 },
    "last_validated_task_revision": { "type": "integer", "minimum": 0 },
    "ownership_epoch_at_acquire": { "type": "integer", "minimum": 0 },
    "path_scope_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "module_scope_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "api_scope_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "schema_scope_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "scope_digest_present": { "const": true },
    "code_baseline_present": { "type": "boolean" },
    "expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "raw_actor_identity_omitted": { "const": true },
    "raw_scope_values_omitted": { "const": true },
    "source_authority_omitted": { "const": true }
  }
}
