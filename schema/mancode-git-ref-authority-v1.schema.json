{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-git-ref-authority-v1.schema.json",
  "title": "Threadforge Mancode git-ref authority migration summary v1",
  "description": "Identity-reduced, non-authorizing review summary of a locally present Mancode team ref.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority", "human_review_required", "execution_authorized",
    "source_ref", "source_commit", "source_manifest_sha256", "manifest_schema_version",
    "workspace_id_sha256", "schema_epoch_present", "minimum_reader_version", "minimum_writer_version",
    "transport_epoch", "config_revision", "authority_state", "authority_freeze_present",
    "authority_tombstone_present", "revision", "actor_profile_count", "ownership_fence_count",
    "claim_count", "handoff_count", "task_bundle_count", "receipt_count", "last_mutation_present",
    "privacy_policy_present", "updated_at", "source_identity_omitted", "execution_authority_omitted"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-git-ref-authority.v1" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "source_ref": { "const": "refs/mancode/team" },
    "source_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_schema_version": { "enum": [1, 2] },
    "workspace_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schema_epoch_present": { "const": true },
    "minimum_reader_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "minimum_writer_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "transport_epoch": { "type": "integer", "minimum": 1 },
    "config_revision": { "type": "integer", "minimum": 1 },
    "authority_state": { "enum": ["active", "frozen", "tombstoned"] },
    "authority_freeze_present": { "type": "boolean" },
    "authority_tombstone_present": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 0 },
    "actor_profile_count": { "type": "integer", "minimum": 0, "maximum": 256 },
    "ownership_fence_count": { "type": "integer", "minimum": 0, "maximum": 512 },
    "claim_count": { "type": "integer", "minimum": 0, "maximum": 2048 },
    "handoff_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "task_bundle_count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "receipt_count": { "type": "integer", "minimum": 0, "maximum": 256 },
    "last_mutation_present": { "type": "boolean" },
    "privacy_policy_present": { "type": "boolean" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_identity_omitted": { "const": true },
    "execution_authority_omitted": { "const": true }
  }
}
