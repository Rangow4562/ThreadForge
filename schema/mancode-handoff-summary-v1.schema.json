{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-handoff-summary-v1.schema.json",
  "title": "Threadforge Mancode handoff migration summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority", "human_review_required", "execution_authorized",
    "source_id_sha256", "task_reference_sha256", "source_state", "revision", "task_revision",
    "ownership_epoch_at_offer", "claim_reference_count", "checkpoint_present", "completed_count",
    "in_progress_count", "not_started_count", "changed_file_count", "verification_item_count",
    "blocker_count", "risk_count", "next_action_present", "transport_mode", "transport_receipt_present",
    "code_reference_present", "resolution_present", "offered_at", "created_at", "updated_at",
    "raw_actor_identities_omitted", "raw_summary_text_omitted", "source_authority_omitted"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-handoff-summary.v1" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "source_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_reference_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_state": { "enum": ["draft", "offered", "accepted", "rejected", "cancelled"] },
    "revision": { "type": "integer", "minimum": 1 },
    "task_revision": { "type": "integer", "minimum": 1 },
    "ownership_epoch_at_offer": { "type": "integer", "minimum": 0 },
    "claim_reference_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "checkpoint_present": { "const": true },
    "completed_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "in_progress_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "not_started_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "changed_file_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "verification_item_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "blocker_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "risk_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "next_action_present": { "type": "boolean" },
    "transport_mode": { "enum": ["local", "git_ref"] },
    "transport_receipt_present": { "type": "boolean" },
    "code_reference_present": { "type": "boolean" },
    "resolution_present": { "type": "boolean" },
    "offered_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "raw_actor_identities_omitted": { "const": true },
    "raw_summary_text_omitted": { "const": true },
    "source_authority_omitted": { "const": true }
  }
}
