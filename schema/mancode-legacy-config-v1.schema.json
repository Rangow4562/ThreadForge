{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-legacy-config-v1.schema.json",
  "title": "Threadforge Mancode legacy configuration projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "human_review_required",
    "execution_authorized",
    "platforms",
    "default_style_configured",
    "minimal_platforms"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-legacy-config.v1" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "platforms": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["claude-code", "cursor", "codex", "copilot", "zcode", "kimi-code", "qoder", "dsh"] }
    },
    "force_team_mode": { "type": "boolean" },
    "team_mode": { "enum": ["auto", "on", "off"] },
    "default_style_configured": { "type": "boolean" },
    "minimal_platforms": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["claude-code", "cursor", "codex", "copilot", "zcode", "kimi-code", "qoder", "dsh"] }
    }
  }
}
