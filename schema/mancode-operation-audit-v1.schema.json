{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-operation-audit-v1.schema.json",
  "title": "Threadforge Mancode operation audit projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority", "human_review_required", "execution_authorized",
    "operation_id_sha256", "operation_type", "source_state", "started_at", "updated_at",
    "requires_reconciliation", "raw_source_identity_omitted", "source_authority_omitted"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-operation-audit.v1" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "operation_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operation_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "source_state": { "enum": ["prepared", "applying", "committed", "repair_required", "aborted"] },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "requires_reconciliation": { "type": "boolean" },
    "raw_source_identity_omitted": { "const": true },
    "source_authority_omitted": { "const": true }
  }
}
