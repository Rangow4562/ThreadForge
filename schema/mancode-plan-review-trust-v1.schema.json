{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-plan-review-trust-v1.schema.json",
  "title": "Threadforge trusted Mancode plan reviewers v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-plan-review-trust.v1" },
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "public_key", "reviewer_id", "products", "not_before", "not_after"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "public_key": { "type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44 },
          "reviewer_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._@/-]{0,127}$" },
          "products": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "mancode" } },
          "not_before": { "type": "string", "format": "date-time" },
          "not_after": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
