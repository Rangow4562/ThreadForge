{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-task-head-summary-v1.schema.json",
  "title": "Threadforge Mancode task-head migration summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority", "human_review_required", "execution_authorized",
    "workspace_id_sha256", "task_reference_sha256", "fence_revision", "task_revision",
    "ownership_epoch", "aggregate_digest_present", "code_reference_present", "checkout_binding_present",
    "remote_revision_present", "updated_at", "raw_task_identity_omitted", "source_authority_omitted"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-task-head-summary.v1" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "workspace_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_reference_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fence_revision": { "type": "integer", "minimum": 1 },
    "task_revision": { "type": "integer", "minimum": 1 },
    "ownership_epoch": { "type": "integer", "minimum": 0 },
    "aggregate_digest_present": { "type": "boolean" },
    "code_reference_present": { "type": "boolean" },
    "checkout_binding_present": { "type": "boolean" },
    "remote_revision_present": { "type": "boolean" },
    "updated_at": { "type": "string", "format": "date-time" },
    "raw_task_identity_omitted": { "const": true },
    "source_authority_omitted": { "const": true }
  }
}
