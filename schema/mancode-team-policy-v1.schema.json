{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/mancode-team-policy-v1.schema.json",
  "title": "Threadforge Mancode team-policy migration projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_kind", "authority", "human_review_required",
    "execution_authorized", "workspace_binding_verified", "revision", "source_policy",
    "recent_days", "default_visibility", "share_confirmed_decisions", "retention", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.mancode-team-policy.v1" },
    "policy_kind": { "const": "team_sharing" },
    "authority": { "const": "local_pending_review" },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "workspace_binding_verified": { "const": false },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "source_policy": { "enum": ["on", "off", "auto"] },
    "recent_days": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "default_visibility": { "enum": ["local", "shared"] },
    "share_confirmed_decisions": { "type": "boolean" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_raw_artifact_days", "local_cache_days", "completed_session_days"],
      "properties": {
        "local_raw_artifact_days": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "local_cache_days": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "completed_session_days": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
