{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/memory-feedback-result-v3.schema.json",
  "title": "Threadforge memory feedback v3 append result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "sequence", "feedback"],
  "properties": {
    "schema_version": { "const": "threadforge.memory-feedback-result.v3" },
    "status": { "const": "recorded" },
    "sequence": { "type": "integer", "minimum": 1 },
    "feedback": {
      "oneOf": [
        { "$ref": "memory-feedback-v1.schema.json" },
        { "$ref": "memory-feedback-v2.schema.json" },
        { "$ref": "memory-feedback-v3.schema.json" }
      ]
    }
  }
}
