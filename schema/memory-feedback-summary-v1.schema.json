{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/memory-feedback-summary-v1.schema.json",
  "title": "Threadforge local memory feedback count summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_id", "records", "groups", "evidence_class", "cutover_evidence_eligible", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.memory-feedback-summary.v1" },
    "status": { "enum": ["complete", "truncated"] },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "records": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "groups": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/group" } },
    "evidence_class": { "const": "self_reported" },
    "cutover_evidence_eligible": { "const": false },
    "execution_authorized": { "const": false }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_kind", "target_id", "target_revision", "harness", "exposure", "utility", "task_result", "count"],
      "properties": {
        "target_kind": { "enum": ["procedure", "fact", "decision", "policy"] },
        "target_id": { "$ref": "continuity-v1.schema.json#/$defs/id" },
        "target_revision": { "type": "integer", "minimum": 1 },
        "harness": { "$ref": "continuity-v1.schema.json#/$defs/id" },
        "exposure": { "enum": ["used", "shown_not_used"] },
        "utility": { "enum": ["helpful", "neutral", "harmful", "not_assessed"] },
        "task_result": { "enum": ["passed", "failed", "inconclusive"] },
        "count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
