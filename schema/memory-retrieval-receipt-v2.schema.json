{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/memory-retrieval-receipt-v2.schema.json",
  "title": "Threadforge local MCP project-memory read handler-result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "task_id", "target_kind", "target_id", "target_revision", "tool", "freshness", "result_status", "guidance_included", "observation_boundary", "created_at"],
  "properties": {
    "schema_version": { "const": "threadforge.memory-retrieval-receipt.v2" },
    "id": { "type": "string", "pattern": "^retrieval-[a-f0-9]{32}$" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "task_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "session_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "target_kind": { "enum": ["fact", "decision", "policy"] },
    "target_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "target_revision": { "type": "integer", "minimum": 1 },
    "tool": { "enum": ["threadforge_project_memory_read", "threadforge_project_memory_read_v2", "threadforge_context_get"] },
    "freshness": { "enum": ["verified", "stale", "incomplete", "unverified", "not_tracked"] },
    "result_status": { "enum": ["complete", "incomplete", "stale", "conflicting", "privacy_blocked"] },
    "guidance_included": { "type": "boolean" },
    "observation_boundary": { "const": "mcp_handler_result_prepared" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "result_status": { "const": "complete" } }, "required": ["result_status"] },
      "then": { "properties": { "guidance_included": { "const": true } } }
    },
    {
      "if": { "properties": { "result_status": { "const": "stale" } }, "required": ["result_status"] },
      "then": {
        "properties": { "freshness": { "const": "stale" }, "guidance_included": { "const": false } }
      }
    },
    {
      "if": { "properties": { "result_status": { "enum": ["conflicting", "privacy_blocked"] } }, "required": ["result_status"] },
      "then": { "properties": { "guidance_included": { "const": false } } }
    },
    {
      "if": { "properties": { "freshness": { "const": "stale" } }, "required": ["freshness"] },
      "then": { "properties": { "result_status": { "const": "stale" }, "guidance_included": { "const": false } } }
    },
    {
      "if": { "properties": { "freshness": { "const": "incomplete" } }, "required": ["freshness"] },
      "then": { "properties": { "guidance_included": { "const": false } } }
    }
  ]
}
