{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/metric-timeseries-v1.schema.json",
  "title": "Threadforge local metric time series v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "measure", "from", "to", "matched_points", "points_truncated", "older_events_omitted", "malformed_lines", "points"],
  "properties": {
    "schema_version": { "const": "threadforge.metric-timeseries.v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$" },
    "measure": { "enum": ["value", "count", "sum", "min", "max"] },
    "from": { "type": "string", "format": "date-time" },
    "to": { "type": "string", "format": "date-time" },
    "matched_points": { "type": "integer", "minimum": 0 },
    "points_truncated": { "type": "boolean" },
    "older_events_omitted": { "type": "boolean" },
    "malformed_lines": { "type": "integer", "minimum": 0 },
    "points": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "value", "harness", "unit", "aggregation"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "value": { "type": "number" },
          "harness": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
          "unit": { "type": "string", "maxLength": 32, "pattern": "^[A-Za-z0-9%{}./_-]*$" },
          "aggregation": { "enum": ["gauge", "sum", "histogram", "exponentialHistogram", "summary"] }
        }
      }
    }
  }
}
