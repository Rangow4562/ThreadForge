{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/migration-format-coverage-v1.schema.json",
  "title": "Threadforge privacy-safe migration format coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "product", "source_fingerprint", "snapshot_sha256", "files_scanned",
    "source_bytes", "records_found", "records_imported", "credential_excluded_records",
    "rejected_records", "snapshot_files", "joined_files", "unsupported_files", "unconverted_files", "unclassified_files", "formats"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.migration-format-coverage.v1" },
    "product": { "enum": ["beacon", "mancode", "anyjev", "rrsi"] },
    "source_fingerprint": { "$ref": "#/$defs/sha256" },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "files_scanned": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "source_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
    "records_found": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "records_imported": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "credential_excluded_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "rejected_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "snapshot_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "joined_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "unsupported_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "unconverted_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "unclassified_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "cross_file_checks": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/cross_file_check" } },
    "mancode_legacy_workflow_checks": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/mancode_legacy_workflow_check" } },
    "mancode_team_policy_checks": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/mancode_team_policy_check" } },
    "formats": { "type": "array", "items": { "$ref": "#/$defs/format" }, "minItems": 1, "maxItems": 64 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "files", "source_bytes", "records_found", "records_imported",
        "credential_excluded_records", "rejected_records", "snapshot_files", "joined_files",
        "unsupported_files", "unconverted_files", "file_set_sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:(?:beacon|mancode|anyjev|rrsi)\\.[a-z0-9]+(?:-[a-z0-9]+)*|unclassified)$" },
        "files": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "source_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "records_found": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "records_imported": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "credential_excluded_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "rejected_records": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "snapshot_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "joined_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unsupported_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unconverted_files": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "file_set_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cross_file_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "relationship", "pair_id_sha256", "policy_file_count", "policy_present", "policy_valid",
        "exclusions_file_count", "exclusions_present", "exclusions_valid", "policy_revision", "expected_exclusions_revision",
        "actual_exclusions_revision", "workspace_binding_verified", "revision_binding_verified",
        "digest_binding_verified", "status", "issues", "authority", "human_review_required", "execution_authorized"
      ],
      "properties": {
        "schema_version": { "const": "threadforge.mancode-privacy-binding-check.v1" },
        "relationship": { "const": "mancode_privacy_policy_exclusions" },
        "pair_id_sha256": { "$ref": "#/$defs/sha256" },
        "policy_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "policy_present": { "type": "boolean" },
        "policy_valid": { "type": "boolean" },
        "policy_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "exclusions_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "exclusions_present": { "type": "boolean" },
        "exclusions_valid": { "type": "boolean" },
        "exclusions_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "policy_revision": { "type": "integer", "minimum": 0 },
        "expected_exclusions_revision": { "type": "integer", "minimum": 0 },
        "actual_exclusions_revision": { "type": "integer", "minimum": 0 },
        "workspace_binding_verified": { "type": "boolean" },
        "revision_binding_verified": { "type": "boolean" },
        "digest_binding_verified": { "type": "boolean" },
        "status": { "enum": ["verified", "incomplete", "conflicting"] },
        "issues": {
          "type": "array", "maxItems": 9, "uniqueItems": true,
          "items": { "enum": [
            "policy_missing", "exclusions_missing", "policy_invalid", "exclusions_invalid",
            "policy_ambiguous", "exclusions_ambiguous", "workspace_mismatch", "revision_mismatch", "digest_mismatch",
            "legacy_unverified"
          ] }
        },
        "authority": { "const": "local_pending_review" },
        "human_review_required": { "const": true },
        "execution_authorized": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "policy_file_count": { "minimum": 1 } } },
          "then": { "properties": { "policy_present": { "const": true } } },
          "else": { "properties": { "policy_present": { "const": false } } }
        },
        {
          "if": { "properties": { "exclusions_file_count": { "minimum": 1 } } },
          "then": { "properties": { "exclusions_present": { "const": true } } },
          "else": { "properties": { "exclusions_present": { "const": false } } }
        },
        {
          "if": { "properties": { "policy_present": { "const": true } } },
          "then": { "required": ["policy_source_set_sha256"] },
          "else": { "not": { "required": ["policy_source_set_sha256"] } }
        },
        {
          "if": { "properties": { "exclusions_present": { "const": true } } },
          "then": { "required": ["exclusions_source_set_sha256"] },
          "else": { "not": { "required": ["exclusions_source_set_sha256"] } }
        },
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": {
            "properties": {
              "policy_present": { "const": true }, "policy_valid": { "const": true },
              "exclusions_present": { "const": true }, "exclusions_valid": { "const": true },
              "workspace_binding_verified": { "const": true }, "revision_binding_verified": { "const": true },
              "digest_binding_verified": { "const": true }, "issues": { "maxItems": 0 }
            }
          },
          "else": { "properties": { "issues": { "minItems": 1 } } }
        }
      ]
    },
    "mancode_legacy_workflow_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "relationship", "workflow_id_sha256",
        "metadata_file_count", "metadata_valid", "requirements_file_count", "requirements_valid",
        "review_file_count", "review_valid", "verification_file_count", "verification_valid",
        "plan_file_count", "plan_valid", "metadata_plan_version_defaulted", "metadata_requirements_digest_present",
        "metadata_requirements_digest_binding_verified", "workflow_path_binding_verified",
        "requirements_digest_binding_verified", "acceptance_criteria_binding_verified", "plan_version_binding_verified",
        "review_remediation_binding_verified", "plan_presence_verified", "plan_content_binding_verified",
        "status", "issues", "authority", "human_review_required", "execution_authorized"
      ],
      "properties": {
        "schema_version": { "const": "threadforge.mancode-legacy-workflow-binding.v1" },
        "relationship": { "const": "mancode_legacy_workflow_ledgers" },
        "workflow_id_sha256": { "$ref": "#/$defs/sha256" },
        "metadata_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "metadata_valid": { "type": "boolean" },
        "metadata_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "requirements_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "requirements_valid": { "type": "boolean" },
        "requirements_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "review_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "review_valid": { "type": "boolean" },
        "review_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "verification_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "verification_valid": { "type": "boolean" },
        "verification_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "plan_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "plan_valid": { "type": "boolean" },
        "plan_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "metadata_plan_version_defaulted": { "type": "boolean" },
        "metadata_plan_version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "metadata_requirements_digest_present": { "type": "boolean" },
        "metadata_requirements_digest_binding_verified": { "type": "boolean" },
        "metadata_requirements_status_present": { "type": "boolean" },
        "metadata_requirements_status_binding_verified": { "type": "boolean" },
        "metadata_verification_status_present": { "type": "boolean" },
        "metadata_verification_status_binding_verified": { "type": "boolean" },
        "workflow_path_binding_verified": { "type": "boolean" },
        "requirements_digest_binding_verified": { "type": "boolean" },
        "acceptance_criteria_binding_verified": { "type": "boolean" },
        "plan_version_binding_verified": { "type": "boolean" },
        "review_remediation_binding_verified": { "type": "boolean" },
        "plan_presence_verified": { "type": "boolean" },
        "plan_content_binding_verified": { "const": false },
        "plan_review_attestation": { "$ref": "mancode-plan-review-attestation-v1.schema.json" },
        "artifact_references": { "$ref": "#/$defs/mancode_legacy_artifact_references" },
        "status": { "enum": ["verified", "incomplete", "conflicting"] },
        "issues": {
          "type": "array", "maxItems": 30, "uniqueItems": true,
          "items": { "enum": [
            "metadata_missing", "metadata_ambiguous", "metadata_invalid",
            "requirements_missing", "requirements_ambiguous", "requirements_invalid",
            "review_ambiguous", "review_invalid", "verification_missing", "verification_ambiguous",
            "verification_invalid", "plan_missing", "plan_ambiguous", "plan_invalid",
            "requirements_digest_mismatch", "acceptance_criteria_mismatch", "plan_version_mismatch",
            "remediation_round_mismatch", "metadata_requirements_digest_mismatch",
            "metadata_requirements_status_mismatch", "metadata_verification_status_mismatch",
            "referenced_artifact_missing", "referenced_artifact_unimported", "referenced_artifact_ambiguous", "referenced_artifact_unavailable",
            "legacy_unverified"
          ] }
        },
        "authority": { "const": "local_pending_review" },
        "human_review_required": { "const": true },
        "execution_authorized": { "const": false }
      },
      "allOf": [
        { "if": { "properties": { "metadata_file_count": { "minimum": 1 } } }, "then": { "required": ["metadata_source_set_sha256"] }, "else": { "not": { "required": ["metadata_source_set_sha256"] } } },
        { "if": { "properties": { "requirements_file_count": { "minimum": 1 } } }, "then": { "required": ["requirements_source_set_sha256"] }, "else": { "not": { "required": ["requirements_source_set_sha256"] } } },
        { "if": { "properties": { "review_file_count": { "minimum": 1 } } }, "then": { "required": ["review_source_set_sha256"] }, "else": { "not": { "required": ["review_source_set_sha256"] } } },
        { "if": { "properties": { "verification_file_count": { "minimum": 1 } } }, "then": { "required": ["verification_source_set_sha256"] }, "else": { "not": { "required": ["verification_source_set_sha256"] } } },
        { "if": { "properties": { "plan_file_count": { "minimum": 1 } } }, "then": { "required": ["plan_source_set_sha256"] }, "else": { "not": { "required": ["plan_source_set_sha256"] } } },
        { "if": { "required": ["plan_review_attestation"] }, "then": { "required": ["metadata_plan_version"], "properties": { "metadata_file_count": { "const": 1 }, "metadata_valid": { "const": true }, "plan_file_count": { "const": 1 }, "plan_valid": { "const": true }, "plan_content_binding_verified": { "const": false }, "status": { "const": "verified" } } } },
        { "if": { "required": ["metadata_requirements_status_binding_verified"], "properties": { "metadata_requirements_status_binding_verified": { "const": true } } }, "then": { "required": ["metadata_requirements_status_present"], "properties": { "metadata_requirements_status_present": { "const": true }, "metadata_valid": { "const": true }, "requirements_valid": { "const": true } } } },
        { "if": { "required": ["metadata_verification_status_binding_verified"], "properties": { "metadata_verification_status_binding_verified": { "const": true } } }, "then": { "required": ["metadata_verification_status_present"], "properties": { "metadata_verification_status_present": { "const": true }, "metadata_valid": { "const": true }, "verification_valid": { "const": true } } } },
        { "if": { "required": ["metadata_requirements_status_present", "status"], "properties": { "metadata_requirements_status_present": { "const": true }, "status": { "const": "verified" } } }, "then": { "required": ["metadata_requirements_status_binding_verified"], "properties": { "metadata_requirements_status_binding_verified": { "const": true } } } },
        { "if": { "required": ["metadata_verification_status_present", "status"], "properties": { "metadata_verification_status_present": { "const": true }, "status": { "const": "verified" } } }, "then": { "required": ["metadata_verification_status_binding_verified"], "properties": { "metadata_verification_status_binding_verified": { "const": true } } } },
        { "if": { "required": ["artifact_references", "status"], "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "artifact_references": { "properties": { "binding_verified": { "const": true } } } } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "metadata_valid": { "const": true }, "requirements_valid": { "const": true }, "verification_valid": { "const": true }, "plan_valid": { "const": true }, "requirements_digest_binding_verified": { "const": true }, "acceptance_criteria_binding_verified": { "const": true }, "plan_version_binding_verified": { "const": true }, "review_remediation_binding_verified": { "const": true }, "plan_presence_verified": { "const": true }, "issues": { "maxItems": 0 } } }, "else": { "properties": { "issues": { "minItems": 1 } } } }
      ]
    },
    "mancode_legacy_artifact_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_count", "found_count", "imported_count", "targets", "binding_verified"],
      "properties": {
        "reference_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "found_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "imported_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "targets": {
          "type": "array", "maxItems": 10000,
          "items": { "$ref": "#/$defs/mancode_legacy_artifact_target" }
        },
        "binding_verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "binding_verified": { "const": true } } },
          "then": {
            "properties": {
              "found_count": { "minimum": 1 },
              "imported_count": { "minimum": 1 }
            }
          }
        }
      ]
    },
    "mancode_legacy_artifact_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_sha256", "source_sha256", "imported"],
      "properties": {
        "path_sha256": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "imported": { "type": "boolean" }
      }
    },
    "mancode_team_policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "relationship", "pair_id_sha256", "team_policy_file_count", "team_policy_valid",
        "project_config_file_count", "project_config_valid", "workspace_binding_verified", "status", "issues",
        "authority", "human_review_required", "execution_authorized"
      ],
      "properties": {
        "schema_version": { "const": "threadforge.mancode-team-policy-binding-check.v1" },
        "relationship": { "const": "mancode_team_policy_project_config" },
        "pair_id_sha256": { "$ref": "#/$defs/sha256" },
        "team_policy_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "team_policy_valid": { "type": "boolean" },
        "team_policy_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "project_config_file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "project_config_valid": { "type": "boolean" },
        "project_config_source_set_sha256": { "$ref": "#/$defs/sha256" },
        "workspace_binding_verified": { "type": "boolean" },
        "status": { "enum": ["verified", "incomplete", "conflicting"] },
        "issues": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": { "enum": [
            "team_policy_missing", "team_policy_ambiguous", "team_policy_invalid",
            "project_config_missing", "project_config_ambiguous", "project_config_invalid",
            "workspace_mismatch", "legacy_unverified"
          ] }
        },
        "authority": { "const": "local_pending_review" },
        "human_review_required": { "const": true },
        "execution_authorized": { "const": false }
      },
      "allOf": [
        { "if": { "properties": { "team_policy_file_count": { "minimum": 1 } } }, "then": { "required": ["team_policy_source_set_sha256"] }, "else": { "not": { "required": ["team_policy_source_set_sha256"] } } },
        { "if": { "properties": { "project_config_file_count": { "minimum": 1 } } }, "then": { "required": ["project_config_source_set_sha256"] }, "else": { "not": { "required": ["project_config_source_set_sha256"] } } },
        { "if": { "properties": { "team_policy_valid": { "const": true } } }, "then": { "properties": { "team_policy_file_count": { "const": 1 } } } },
        { "if": { "properties": { "project_config_valid": { "const": true } } }, "then": { "properties": { "project_config_file_count": { "const": 1 } } } },
        { "if": { "properties": { "workspace_binding_verified": { "const": true } } }, "then": { "properties": { "team_policy_valid": { "const": true }, "project_config_valid": { "const": true } } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "team_policy_valid": { "const": true }, "project_config_valid": { "const": true }, "workspace_binding_verified": { "const": true }, "issues": { "maxItems": 0 } } }, "else": { "properties": { "issues": { "minItems": 1 } } } }
      ]
    }
  }
}
