{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schemas/migration-private-artifacts-v1.schema.json",
  "title": "Threadforge private migration artifact index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "migration_id", "source_fingerprint", "artifacts"],
  "properties": {
    "schema_version": {"const": "threadforge.migration-private-artifacts.v1"},
    "migration_id": {"type": "string", "pattern": "^anyjev-[a-f0-9]{20}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "sha256", "bytes", "local_path"],
        "properties": {
          "source_path": {
            "type": "string",
            "pattern": "^bench/results_distill/synth_(labels|features)/[^/]+/[^/]+\\.(synth|test)\\.npz$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
          "local_path": {"type": "string", "pattern": "^artifacts/sha256/[a-f0-9]{64}\\.npz$"}
        }
      }
    }
  }
}
