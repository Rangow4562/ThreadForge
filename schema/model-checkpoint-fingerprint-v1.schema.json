{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/model-checkpoint-fingerprint-v1.schema.json",
  "title": "Threadforge local model checkpoint fingerprint receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sha256", "file_count", "total_bytes"],
  "properties": {
    "schema_version": { "const": "threadforge.model-checkpoint-fingerprint.v1" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "total_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776 }
  }
}
