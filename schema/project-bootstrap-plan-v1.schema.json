{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-bootstrap-plan-v1.schema.json",
  "title": "Threadforge Project MCP Bootstrap Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_root_sha256", "hosts", "mutates_files", "configuration_preflight", "host_trust_changed", "permissions_changed", "telemetry_enabled", "limitations"],
  "properties": {
    "schema_version": { "const": "threadforge.project-bootstrap-plan.v1" },
    "status": { "const": "planned" },
    "project_root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "config_path", "action"],
        "properties": {
          "host": { "enum": ["claude-code", "command-code", "github-copilot", "cursor", "antigravity", "gemini-cli", "qwen-code", "codex-cli", "chatgpt-desktop-codex", "codex-ide", "opencode"] },
          "config_path": { "type": "string", "minLength": 1, "maxLength": 128 },
          "action": { "const": "install_or_match" }
        }
      }
    },
    "mutates_files": { "const": false },
    "configuration_preflight": { "const": "not_read" },
    "host_trust_changed": { "const": false },
    "permissions_changed": { "const": false },
    "telemetry_enabled": { "const": false },
    "limitations": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  }
}
