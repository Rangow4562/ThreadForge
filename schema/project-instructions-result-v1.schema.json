{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-instructions-result-v1.schema.json",
  "title": "Threadforge Project Instructions Bootstrap Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "status", "targets", "atomic", "partial_changes_possible", "host_trust_changed", "permissions_changed", "guidance_only", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.project-instructions-result.v1" },
    "action": { "enum": ["install", "update", "uninstall"] },
    "status": { "enum": ["complete", "partial"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hosts", "path", "result"],
        "properties": {
          "hosts": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "enum": ["claude-code", "command-code", "cursor", "antigravity", "gemini-cli", "codex-cli", "chatgpt-desktop-codex", "codex-ide", "opencode", "qwen-code", "github-copilot", "zcode", "kimi-code", "qoder", "deepseek-harness", "goose"] } },
          "path": { "enum": ["AGENTS.md", "CLAUDE.md", "GEMINI.md", "QWEN.md", ".github/copilot-instructions.md", ".goosehints"] },
          "result": { "enum": ["installed", "updated", "unchanged", "removed", "absent", "failed"] },
          "failure_code": { "const": "instruction_conflict_or_unavailable" }
        },
        "allOf": [
          {
            "if": { "properties": { "result": { "const": "failed" } }, "required": ["result"] },
            "then": { "required": ["failure_code"] },
            "else": { "not": { "required": ["failure_code"] } }
          }
        ]
      }
    },
    "atomic": { "const": false },
    "partial_changes_possible": { "type": "boolean" },
    "host_trust_changed": { "const": false },
    "permissions_changed": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": { "properties": { "partial_changes_possible": { "const": true } } },
      "else": { "properties": { "partial_changes_possible": { "const": false } } }
    }
  ]
}
