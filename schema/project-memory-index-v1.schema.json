{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-memory-index-v1.schema.json",
  "title": "Threadforge Project Memory Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_id", "records", "total_count", "count", "limit", "offset", "has_more", "next_offset", "gaps", "action_ready", "guidance_only", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.project-memory-index.v1" },
    "status": { "enum": ["complete", "conflicting", "incomplete", "privacy_blocked"] },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "records": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/entry" } },
    "total_count": { "type": "integer", "minimum": 0 },
    "count": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "minimum": 0 },
    "has_more": { "type": "boolean" },
    "next_offset": { "type": "integer", "minimum": 0 },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "action_ready": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision", "title", "applicability", "content_sha256", "updated_at", "state"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "kind": { "enum": ["fact", "decision", "policy"] },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "applicability": { "$ref": "https://threadforge.invalid/schema/project-memory-v1.schema.json#/$defs/applicability" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "updated_at": { "type": "string", "format": "date-time" },
        "state": { "enum": ["approved", "superseded", "conflicting"] },
        "conflict_key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "supersedes_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    }
  }
}
