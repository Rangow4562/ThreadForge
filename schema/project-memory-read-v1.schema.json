{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-memory-read-v1.schema.json",
  "title": "Threadforge Project Memory Read v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "freshness", "project_id", "id", "kind", "gaps", "action_ready", "guidance_only", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.project-memory-read.v1" },
    "status": { "enum": ["complete", "incomplete", "conflicting", "privacy_blocked"] },
    "freshness": { "const": "not_tracked_by_project_memory_v1" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "kind": { "enum": ["fact", "decision", "policy"] },
    "revision": { "type": "integer", "minimum": 1 },
    "record": { "$ref": "https://threadforge.invalid/schema/project-memory-v1.schema.json" },
    "retrieval_receipt": { "$ref": "https://threadforge.dev/schema/memory-retrieval-receipt-v2.schema.json" },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "action_ready": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
      "then": { "required": ["revision", "record"] },
      "else": { "not": { "required": ["record"] } }
    }
  ]
}
