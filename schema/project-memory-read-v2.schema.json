{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-memory-read-v2.schema.json",
  "title": "Threadforge Project Memory Read v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "freshness", "project_id", "id", "kind", "gaps", "action_ready", "guidance_only", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.project-memory-read.v2" },
    "status": { "enum": ["complete", "incomplete", "stale", "conflicting", "privacy_blocked"] },
    "freshness": { "enum": ["verified", "stale", "incomplete", "unverified"] },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "kind": { "enum": ["fact", "decision", "policy"] },
    "revision": { "type": "integer", "minimum": 1 },
    "record": { "oneOf": [
      { "$ref": "https://threadforge.invalid/schema/project-memory-v1.schema.json" },
      { "$ref": "https://threadforge.invalid/schema/project-memory-v2.schema.json" }
    ] },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "action_ready": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
      "then": {
        "required": ["revision", "record"],
        "properties": { "freshness": { "const": "verified" } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "stale" } }, "required": ["status"] },
      "then": {
        "properties": { "freshness": { "const": "stale" } },
        "not": { "required": ["record"] }
      }
    },
    {
      "if": { "properties": { "freshness": { "enum": ["incomplete", "stale"] } }, "required": ["freshness"] },
      "then": { "not": { "required": ["record"] } }
    }
  ]
}
