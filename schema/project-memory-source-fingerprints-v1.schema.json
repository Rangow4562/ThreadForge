{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-memory-source-fingerprints-v1.schema.json",
  "title": "Threadforge Project Memory Source Fingerprints v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "sources"],
  "properties": {
    "schema_version": { "const": "threadforge.project-memory-source-fingerprints.v1" },
    "status": { "const": "complete" },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
