{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.invalid/schema/project-memory-v1.schema.json",
  "title": "Threadforge Approved Project Memory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "kind", "title", "revision", "status", "content", "content_sha256", "evidence", "created_at", "updated_at", "approval"],
  "properties": {
    "schema_version": { "const": "threadforge.project-memory.v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "kind": { "enum": ["fact", "decision", "policy"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "applicability": { "$ref": "#/$defs/applicability" },
    "conflict_key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "supersedes_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "const": "approved" },
    "content": { "type": "object" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/evidence" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "applicability": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "modules": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "paths": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "content_sha256", "redacted"],
      "properties": {
        "origin": { "enum": ["trace", "document", "human", "benchmark"] },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "harness": { "type": "string", "maxLength": 128 },
        "redacted": { "const": true }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "reason", "privacy_reviewed"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approved_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "privacy_reviewed": { "const": true }
      }
    }
  }
}
