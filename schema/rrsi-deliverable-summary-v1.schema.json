{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/rrsi-deliverable-summary-v1.schema.json",
  "title": "Threadforge RRSI content-free deliverable summary v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "threadforge.rrsi-deliverable-summary.v1" },
    "domain": { "enum": ["coding", "workspace", "eng"] },
    "record_kind": { "enum": ["coding_terminal_recording", "workspace_deliverable", "engineering_payload"] },
    "job_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trial_key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_path_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_bytes": { "type": "integer", "minimum": 0, "maximum": 33554432 },
    "content_imported": { "const": false },
    "human_review_required": { "const": true },
    "execution_authorized": { "const": false },
    "cutover_evidence_eligible": { "const": false }
  },
  "required": [
    "schema_version", "domain", "record_kind", "job_id_sha256", "task_id_sha256",
    "trial_key_sha256", "artifact_path_sha256", "source_sha256", "source_bytes",
    "content_imported", "human_review_required", "execution_authorized", "cutover_evidence_eligible"
  ],
  "allOf": [
    {
      "if": { "properties": { "domain": { "const": "coding" } }, "required": ["domain"] },
      "then": { "properties": { "record_kind": { "const": "coding_terminal_recording" } } }
    },
    {
      "if": { "properties": { "domain": { "const": "workspace" } }, "required": ["domain"] },
      "then": { "properties": { "record_kind": { "const": "workspace_deliverable" } } }
    },
    {
      "if": { "properties": { "domain": { "const": "eng" } }, "required": ["domain"] },
      "then": { "properties": { "record_kind": { "const": "engineering_payload" } } }
    }
  ]
}
