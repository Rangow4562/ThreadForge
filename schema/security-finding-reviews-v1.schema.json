{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.ai/schema/security-finding-reviews-v1.schema.json",
  "title": "Threadforge paginated security finding review list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "total", "limit", "offset", "reviews"],
  "properties": {
    "schema_version": { "const": "threadforge.security-finding-reviews.v1" },
    "total": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "offset": { "type": "integer", "minimum": 0 },
    "reviews": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "security-finding-review-v1.schema.json" }
    }
  }
}
