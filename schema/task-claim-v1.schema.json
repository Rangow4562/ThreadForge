{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/task-claim-v1.schema.json",
  "title": "Threadforge local task claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "task_id", "owner", "scopes", "task_revision", "baseline_sha256", "lease_expires_at", "status", "revision", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "threadforge.task-claim.v1" },
    "id": { "$ref": "continuity-v1.schema.json#/$defs/id" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "task_id": { "$ref": "continuity-v1.schema.json#/$defs/id" },
    "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scopes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/scope" } },
    "task_revision": { "type": "integer", "minimum": 1 },
    "baseline_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lease_expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "released"] },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "released_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "released" } }, "required": ["status"] },
      "then": { "required": ["released_at"] },
      "else": { "not": { "required": ["released_at"] } }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["path", "module", "api", "schema"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
