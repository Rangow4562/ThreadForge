{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/task-handoff-event-v1.schema.json",
  "title": "Threadforge task handoff event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "expected_revision", "handoff"],
  "properties": {
    "schema_version": { "const": "threadforge.task-handoff-event.v1" },
    "action": { "enum": ["drafted", "offered", "accepted", "rejected", "cancelled"] },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "handoff": { "$ref": "task-handoff-v1.schema.json" }
  }
}
