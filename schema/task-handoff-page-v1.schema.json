{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/task-handoff-page-v1.schema.json",
  "title": "Threadforge task handoff page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "handoffs", "total_count", "offset", "limit", "has_more", "action_ready", "guidance_only", "execution_authorized"],
  "properties": {
    "schema_version": { "const": "threadforge.task-handoff-page.v1" },
    "task_id": { "$ref": "continuity-v1.schema.json#/$defs/id" },
    "handoffs": { "type": "array", "maxItems": 100, "items": { "$ref": "task-handoff-v1.schema.json" } },
    "total_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "has_more": { "type": "boolean" },
    "action_ready": { "const": false },
    "guidance_only": { "const": true },
    "execution_authorized": { "const": false }
  }
}
