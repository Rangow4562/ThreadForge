{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/task-plan-v1.schema.json",
  "title": "Threadforge task plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "markdown", "decision"],
  "properties": {
    "schema_version": { "const": "threadforge.task-plan.v1" },
    "version": { "type": "integer", "minimum": 1 },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "implementation_scope": { "$ref": "#/$defs/scope" },
    "decision": { "enum": ["unconfirmed", "plan_only", "governed_execution"] },
    "confirmed_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "confirmation_reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "unconfirmed" } } },
      "then": { "not": { "anyOf": [ { "required": ["confirmed_by"] }, { "required": ["confirmed_at"] }, { "required": ["confirmation_reason"] } ] } },
      "else": { "required": ["confirmed_by", "confirmed_at", "confirmation_reason"] }
    },
    {
      "if": { "properties": { "decision": { "const": "governed_execution" } } },
      "then": { "required": ["implementation_scope"] }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/scope_item" } },
        "exclude": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/scope_item" } },
        "modules": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "scope_item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*:).+$"
    }
  }
}
