{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/team-procedure-manifest-v1.schema.json",
  "title": "Threadforge Git-ref shared procedure manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "remote_identity_sha256",
    "revision",
    "record_count",
    "total_bytes",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.team-procedure-manifest.v1" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "remote_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "parent_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "total_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "revision": { "const": 1 } }, "required": ["revision"] },
      "then": { "not": { "required": ["parent_manifest_sha256"] } },
      "else": { "required": ["parent_manifest_sha256"] }
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^procedures/[a-z][a-z0-9-]{0,63}/rev-[0-9]{6,}\\.json$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 }
      }
    }
  }
}
