{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadforge.dev/schema/team-sync-receipt-v1.schema.json",
  "title": "Threadforge Git-ref team procedure sync receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction",
    "project_id",
    "remote_revision",
    "record_count",
    "imported_records",
    "already_present_records",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "threadforge.team-sync-receipt.v1" },
    "direction": { "enum": ["pull", "push"] },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "remote_revision": { "type": "integer", "minimum": 0 },
    "record_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "imported_records": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "already_present_records": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["empty", "pulled", "already_current", "published"] }
  }
}
